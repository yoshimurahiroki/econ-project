  "pointer_templates": {
    "economics-task-entry": "# Economics task entry\n\nRead [CORE]({core}) and [PROSE]({prose}), then select the owner and mode from the [operation index]({index}). Obtain the complete selected operation contract and activated conditions through the registry resolver or the package's generated instructions. Read the complete selected skill/mode and every required rule body and activated dependency. Reuse same-version text still present in context. CORE governs reasoning, execution, integrated review and applicable verification.\n"
  },
  "configuration": {
    "clients": [
      "cursor",
      "cline",
      "roo",
      "windsurf",
      "gemini",
      "claude",
      "codex",
      "vscode",
      "devcontainer",
      "project",
      "agents"
    ],
    "default_mode": "diff",
    "write_requires": "explicit_client_selection",
    "ownership": "previous_generated_current_proposed_content",
    "relative_path_base": "declared_project_root",
