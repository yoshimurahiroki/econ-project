    "skills_root": "skills",
    "runtime_root": "runtime",
    "profiles_root": "profiles",
    "policy_root": "references/repository-policy"
  },
  "deployed": {
    "skills_root": ".agents/skills",
    "runtime_root": ".agents/runtime",
    "profiles_root": ".agents/profiles",
    "policy_root": "."
  },
  "project": {
    "layout": "flat",
    "path_field": "export_alias",
    "mandatory_reference_policy": "resolve_within_selected_package",
    "omitted_optional_policy": "request_additional_input_if_activated",
    "remote_fallback": false
  },
