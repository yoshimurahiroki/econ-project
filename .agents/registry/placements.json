    "skills_root": ".agents/skills",
    "runtime_root": ".agents/runtime",
    "profiles_root": ".agents/profiles",
    "policy_root": "."
  },
  "project": {
    "layout": "flat",
    "path_field": "export_alias",
    "mandatory_reference_policy": "resolve_within_selected_package",
    "omitted_optional_policy": "request_additional_input_if_activated",
    "remote_fallback": false
  },
  "configuration": {
    "clients": [
      "cursor",
      "cline",
      "roo",
      "windsurf",
      "gemini",
      "claude",
      "codex",
      "vscode",
      "devcontainer",
      "project",
      "agents"
    ],
    "default_mode": "diff",
    "write_requires": "explicit_client_selection",
    "ownership": "previous_generated_current_proposed_content",
    "relative_path_base": "declared_project_root",
    "configuration_clients": {
      "cursor": [
        {
          "path": ".cursor/mcp.json",
          "format": "json"
        }
      ],
      "cline": [
        {
          "path": ".vscode/cline_mcp_settings.json",
          "format": "json"
        }
      ],
      "roo": [
        {
          "path": ".vscode/roo_cline_mcp_settings.json",
          "format": "json"
        }
      ],
      "windsurf": [
        {
          "path": ".windsurf/mcp.json",
          "format": "json"
        }
      ],
      "gemini": [
        {
          "path": ".gemini/mcp.json",
          "format": "json"
        },
        {
          "path": ".gemini/mcp-configs/mcp-servers.json",
          "format": "json"
        }
      ],
      "claude": [
        {
          "path": ".mcp.json",
          "format": "json"
        },
        {
          "path": ".claude/mcp-configs/mcp-servers.json",
          "format": "json"
        }
      ],
      "codex": [
        {
          "path": ".codex/config.toml",
          "format": "toml"
        }
      ],
      "vscode": [
        {
          "path": ".vscode/settings.json",
          "format": "json"
        }
      ],
      "devcontainer": [
        {
          "path": ".devcontainer/devcontainer.json",
          "format": "devcontainer"
        }
      ],
      "project": [
        {
          "path": "mcp.json",
          "format": "json"
        }
      ],
      "agents": [
        {
          "path": ".agents/mcp.json",
          "format": "json"
        }
      ]
    }
  },
