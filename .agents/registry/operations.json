      "id": "econ-data:equity",
      "owner_skill": "econ-data",
      "mode": "equity",
      "trigger": "Evaluate Japanese, US and overseas equities from public filings, IR and market observations; estimate competition, compute sustainable cash flows, reverse valuation, after-tax investment decisions and news-driven changes.",
      "required_rules": [
        "core.all",
        "econ-data.all",
        "equity-guide.all",
        "prose.select-the-economic-argument",
        "prose.connect-the-explanation",
        "equity-models.all"
      ],
      "conditional_rules": [
        {
          "conditional_rule_set": "data-execution"
        },
        {
          "when": "economic_knowledge_needed"
        }
      ],
      "uses_profile": false,
      "result_contract": {
        "meaning": "Executed market definition, source observations, identification and estimates, competitive equilibrium, sustainable cash-flow and net-cash bridge, fair and market-implied value, attainable after-tax investment decision and attributed news update. Uncomputed real-company stages remain unfinished."
      }
    },
