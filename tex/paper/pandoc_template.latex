% !TEX program = lualatex
% Econometrica manuscript on the Econometric Society class (econsocart.cls,
% econsocart.cfg, ecta-fullname.bst). Option [draft] typesets the submission
% version; [final] the prepublication version. Grey angle-bracket slots mark
% the content each sentence carries.
\RequirePackage{fontspec}
\def\econselectedclass{$documentclass$}
\def\econjournalclass{econsocart}
\ifx\econselectedclass\econjournalclass
\documentclass[ecta,nameyear,$if(classoption)$$for(classoption)$$classoption$$sep$,$endfor$$else$final$endif$]{econsocart}
\else
\documentclass[$for(classoption)$$classoption$$sep$,$endfor$]{$documentclass$}
\fi

\RequirePackage[colorlinks,citecolor=blue,linkcolor=blue,urlcolor=blue,pagebackref]{hyperref}
\usepackage{luatexja-fontspec}
\usepackage{xcolor}
\usepackage{amssymb}
\usepackage{bm}
\usepackage{float}
\usepackage{booktabs}
\usepackage{longtable}
\usepackage{threeparttable}
\ifdefined\abovecaptionskip\else\newlength{\abovecaptionskip}\fi
\usepackage{graphicx}
\newcommand{\hiddenlabel}[1]{\refstepcounter{equation}\label{#1}}
\newcommand{\hiddenfiglabel}[1]{\refstepcounter{figure}\label{#1}}
\newcommand{\hiddentablabel}[1]{\refstepcounter{table}\label{#1}}

$if(bibliography)$$else$\let\econbibstyle\bibliographystyle
\renewcommand{\bibliographystyle}[1]{}
$endif$$common.latex()$
$if(bibliography)$$else$\let\bibliographystyle\econbibstyle
$endif$$if(standalone-renderer)$$for(header-includes)$
$header-includes$
$endfor$
$endif$$if(japanese)$
\AtBeginDocument{\renewcommand{\tablename}{表}\renewcommand{\figurename}{図}\renewcommand{\thetable}{\arabic{table}}\renewcommand{\thefigure}{\arabic{figure}}}
$endif$
\raggedbottom
\AtBeginEnvironment{longtable}{\def\_{\textunderscore\allowbreak}}
\newcounter{pandocauthor}
\newcommand{\pandocauthor}[1]{\stepcounter{pandocauthor}\author[id=au\arabic{pandocauthor},addressref={add1}]{\fnms{}~\snm{#1}\ead[label=e\arabic{pandocauthor}]{}}}
\ifx\econselectedclass\econjournalclass
\startlocaldefs
\newcommand{\econtheorem}[3]{\ifcsname #1\endcsname\else\theoremstyle{#2}\newtheorem{#1}{#3}\fi}
\econtheorem{assumption}{plain}{Assumption}
\econtheorem{proposition}{plain}{Proposition}
\econtheorem{lemma}{plain}{Lemma}
\econtheorem{corollary}{plain}{Corollary}
\econtheorem{definition}{remark}{Definition}
\econtheorem{example}{remark}{Example}
\ifdefined\slot\else\DeclareRobustCommand{\slot}[1]{{\color{gray}\itshape\ensuremath{\langle}#1\ensuremath{\rangle}}}\fi
\newcommand{\E}{\mathbb{E}}
\newcommand{\Var}{\operatorname{Var}}
\endlocaldefs
\fi

\begin{document}

\ifx\econselectedclass\econjournalclass
\begin{frontmatter}

$if(title)$\title{$title$}
\runtitle{$title$}$endif$

\begin{aug}
$for(author)$\pandocauthor{$author$}
$endfor$\address[id=add1]{}

$if(support)$\support{$support$}$endif$

$if(abstract)$\begin{abstract}
$abstract$
\end{abstract}$endif$

$if(keywords)$\begin{keyword}
$for(keywords)$\kwd{$keywords$}
$endfor$\end{keyword}$endif$

\end{aug}

\end{frontmatter}
\else
$if(title)$\title{$title$}$endif$
\author{$for(author)$$author$$sep$ \and $endfor$}
$if(date)$\date{$date$}$endif$
$if(title)$\maketitle$endif$
$if(abstract)$\begin{abstract}$abstract$\end{abstract}$endif$
$if(keywords)$\noindent\textbf{Keywords:} $for(keywords)$$keywords$$sep$, $endfor$$endif$
\fi

$body$

% Bibliography style is set to ecta-fullname by the renderer.
$if(bibliography)$\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}$endif$

\end{document}
