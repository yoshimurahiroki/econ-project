%\newtheorem*{???}{???}
%\newtheorem{???}{???}[???]
%\newtheorem{???}[???]{???}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Please put your definitions here:        %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


\endlocaldefs
\fi

\begin{document}

\ifx\econselectedclass\econjournalclass
\begin{frontmatter}

$if(title)$\title{$title$}
\runtitle{$title$}$endif$

\begin{aug}
% use \particle for den|der|de|van|von (only lc!)
% [id=?,addressref=?,corref]{\fnms{}~\snm{}\ead[label=e?]{}\thanksref{}}
%
%% e-mail is mandatory for each author
%
%%% initials in fnms (if any) with spaces
%
$for(author)$\pandocauthor{$author$}
$endfor$
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Addresses                                %%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\address[id=add1]{}

\support{}

%% Put support info here.  Reminder: do not thank the handling coeditor anonymously or by name
%% \support{We thank ???.}
%
$if(abstract)$\begin{abstract}
$abstract$
\end{abstract}$endif$

$if(keywords)$\begin{keyword}
$for(keywords)$\kwd{$keywords$}
$endfor$\end{keyword}$endif$

\end{aug}

\end{frontmatter}
\else
$if(title)$\title{$title$}$endif$
\author{$for(author)$$author$$sep$ \and $endfor$}
$if(date)$\date{$date$}$endif$
$if(title)$\maketitle$endif$
$if(abstract)$\begin{abstract}$abstract$\end{abstract}$endif$
$if(keywords)$\noindent\textbf{Keywords:} $for(keywords)$$keywords$$sep$, $endfor$$endif$
\fi
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%% Main text entry area:
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

$body$

