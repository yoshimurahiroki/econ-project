\usepackage{color}
\usepackage{luatexja}
\usepackage{comment}
\usepackage{natbib}

\usepackage[haranoaji,deluxe,scale=1]{luatexja-preset}
\usepackage{appendixnumberbeamer}
\renewcommand{\kanjifamilydefault}{\gtdefault}
\renewcommand{\refname}{}
\renewcommand{\bibsection}{}

$if(theme)$\usetheme{$theme$}$else$\usetheme[numbering=fraction]{metropolis}$endif$
\usefonttheme[onlymath]{serif}

\definecolor{Waseda}{HTML}{922E41}
\definecolor{Orange}{HTML}{CF4A30}
\setbeamercolor{alerted text}{fg=Orange}
\setbeamercolor{frametitle}{bg=Waseda}
\geometry{paperwidth=960bp,paperheight=540bp}
\setbeamersize{text margin left=54bp,text margin right=54bp}
\newif\ifersjapanese
$if(japanese)$\ersjapanesetrue$endif$
\ifersjapanese
  \newcommand{\ersbodyfontsize}{32}\newcommand{\ersbodyleading}{40}
  \newcommand{\ersframetitlefont}{\fontsize{36}{44}\selectfont}
  \newcommand{\erstitlefont}{\fontsize{44}{54}\selectfont}
  \DeclareMathSizes{32}{32}{22}{16}
\else
  \newcommand{\ersbodyfontsize}{28}\newcommand{\ersbodyleading}{35}
  \newcommand{\ersframetitlefont}{\fontsize{32}{40}\selectfont}
  \newcommand{\erstitlefont}{\fontsize{40}{48}\selectfont}
  \DeclareMathSizes{28}{28}{20}{14}
\fi
\makeatletter
\renewcommand\normalsize{\@setfontsize\normalsize{\ersbodyfontsize}{\ersbodyleading}}
\makeatother
\setbeamerfont{normal text}{size=\normalsize}
\setbeamerfont{itemize/enumerate body}{size=\normalsize}
\setbeamerfont{itemize/enumerate subbody}{size=\normalsize}
\setbeamerfont{itemize/enumerate subsubbody}{size=\normalsize}
\setbeamerfont{title}{size=\erstitlefont}
\setbeamerfont{subtitle}{size=\normalsize}
\setbeamerfont{frametitle}{size=\ersframetitlefont,series=\bfseries}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\normalsize}
\setbeamerfont{date}{size=\normalsize}
\setbeamerfont{caption}{size=\normalsize}
\setbeamerfont{footnote}{size=\normalsize}
\AtBeginDocument{\normalsize}

$if(title)$\title{$title$}$endif$
$if(subtitle)$\subtitle{$subtitle$}$endif$
\author{$for(author)$$author$$sep$ \and $endfor$}
$if(institute)$\institute{$institute$}$endif$
\date{$if(date)$$date$$else$\today$endif$}

%%%%% DOCUMENT %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\usepackage{amsmath}
$if(bibliography)$$else$\let\econbibstyle\bibliographystyle
\renewcommand{\bibliographystyle}[1]{}
$endif$$common.latex()$
$if(bibliography)$$else$\let\bibliographystyle\econbibstyle
$endif$$if(standalone-renderer)$$for(header-includes)$
$header-includes$
$endfor$
$endif$\AtBeginEnvironment{longtable}{\normalsize\setlength{\tabcolsep}{8pt}\renewcommand{\arraystretch}{1.25}}
\begin{document}

