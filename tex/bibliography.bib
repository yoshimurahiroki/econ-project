@ARTICLE{Schreck2004-Specifying_The_Influence_Of_Family_And_Peers_On_Violent_Victimization_Extending_Routine_Activities_And_Lifestyles_Theories_Extending_Routine_Activities_And_Lifestyles_Theories-..-eg,
