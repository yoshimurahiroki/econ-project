}

@ARTICLE{Feigenberg2025-Class_Disparities_And_Discrimination_In_Traffic_Stops_And_Searches-..-lh,
  title    = "Class disparities and discrimination in traffic stops and searches",
  author   = "Feigenberg, B and Miller, Conrad",
  journal  = "SSRN Electronic Journal",
  abstract = "We document class disparities and discrimination in the incidence
              of police searches. Lowincome motorists are more likely to be
              pursued in pretext stops and to be searched for contraband. Yet
              searches of low-income motorists are less likely to yield
              contraband. To isolate class-based discrimination, we show that
              motorists stopped in multiple vehicles are more likely to be
              searched when stopped in a vehicle that signals they are
              low-income. Overall contraband yield would increase if police did
              not engage in vehicle-based profiling. We provide suggestive
              evidence that lower hassle costs associated with arrests of
              low-income motorists help to explain trooper behavior. University
              of Illinois, Chicago (email: bfeigenb@uic.edu). Haas School of
              Business, University of California, Berkeley and NBER (email:
