@ARTICLE{Radil2010-Spatializing_Social_Networks_Using_Social_Network_Analysis_To_Investigate_Geographies_Of_Gang_Rivalry_Territoriality_And_Violence_In_Los_Angeles-..-py,
  title     = "Spatializing social networks: Using social network analysis to
