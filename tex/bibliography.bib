@ARTICLE{Dulisse2024-_Get_Rich_Quick_Scheme_Or_Script_The_Effect_Of_Cryptoculture_On_The_Susceptibility_Of_Fraud_Victimization_Among_Cryptocurrency_Purchasers-..-vi,
