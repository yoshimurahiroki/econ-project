@ARTICLE{Heinen2019-Bicycle_Parking_A_Systematic_Review_Of_Scientific_Literature_On_Parking_Behaviour_Parking_Preferences_And_Their_Influence_On_Cycling_And_Travel_Behaviour-..-no,
