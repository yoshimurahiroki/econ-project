  month     =  mar,
  year      =  2020,
  keywords  = "",
  language  = "en"
}

@ARTICLE{Hernandez2000-The_Study_Of_Environmental_Beliefs_By_Facet_Analysis_Research_In_The_Canary_Islands_Spain-..-au,
