@ARTICLE{Nivette2021-Non-compliance_With_COVID-19-related_Public_Health_Measures_Among_Young_Adults_In_Switzerland_Insights_From_A_Longitudinal_Cohort_Study-..-fq,
  title     = "Non-compliance with {COVID}-19-related public health measures
