  author    = "Bindler, Anna and Hjalmarsson, Randi",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  10,
  number    =  4,
  pages     = "36--78",
  abstract  = "This paper studies the effect of punishment severity on jury
