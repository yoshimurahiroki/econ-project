@ARTICLE{Ash2023-How_Cable_News_Reshaped_Local_Government-..-qh,
  title     = "How cable news reshaped local government",
  author    = "Ash, Elliott and Galletta, Sergio",
  journal   = "American Economic Journal. Applied Economics",
  publisher = "American Economic Association",
  volume    =  15,
  number    =  4,
  pages     = "292--320",
  abstract  = "This paper shows that partisan cable news broadcasts have a
               causal effect on the size and composition of budgets in US
               localities. Using exogenous channel positioning as an instrument
               for viewership, we show that exposure to the conservative Fox
               News channel reduces revenues and expenditures. Multiple
