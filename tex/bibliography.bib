}

@ARTICLE{Li2010-A_Multilevel_Analysis_Of_Individual_Household_And_Neighborhood_Correlates_Of_Intimate_Partner_Violence_Among_Low-income_Pregnant_Women_In_Jefferson_County_Alabama-..-pl,
