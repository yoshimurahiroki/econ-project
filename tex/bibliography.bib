@ARTICLE{Keuschnigg2018-Thou_Shalt_Recycle_How_Social_Norms_Of_Environmental_Protection_Narrow_The_Scope_Of_The_Low-cost_Hypothesis-..-vi,
  title     = "Thou shalt recycle: How social norms of environmental protection
