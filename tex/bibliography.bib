}

@ARTICLE{Ouss2023-Does_Cash_Bail_Deter_Misconduct_-..-aw,
  title     = "Does cash bail deter misconduct?",
  author    = "Ouss, Aurélie and Stevenson, Megan",
  journal   = "American Economic Journal. Applied Economics",
