}

@ARTICLE{Lacoe2015-Mortgage_Foreclosures_And_The_Changing_Mix_Of_Crime_In_Micro-neighborhoods-..-ow,
  title     = "Mortgage foreclosures and the changing mix of crime in
               micro-neighborhoods",
  author    = "Lacoe, Johanna and Ellen, Ingrid Gould",
  journal   = "The journal of research in crime and delinquency",
  publisher = "SAGE Publications",
  volume    =  52,
  number    =  5,
  pages     = "717--746",
  abstract  = "Objectives: The main objectives of the study are to estimate the
               impact of mortgage foreclosures on the location of criminal
               activity within a blockface. Drawing on routine activity theory,
               disorder theory, and social disorganization theory, the study
               explores potential mechanisms that link foreclosures to crime.
               Methods: To estimate the relationship between foreclosures and
               localized crime, we use detailed foreclosure and crime data at
               the blockface level in Chicago and a difference-in-difference
               estimation strategy. Results: Overall, mortgage foreclosures
               increase crime on blockfaces. Foreclosures have a larger impact
