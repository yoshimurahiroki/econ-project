@ARTICLE{Melde2016-Fear_Social_Interactions_And_Violence_Mitigation-..-zi,
  title     = "Fear, social interactions, and violence mitigation",
  author    = "Melde, Chris and Berg, Mark T and Esbensen, Finn-Aage",
  journal   = "Justice quarterly",
  publisher = "Informa UK Limited",
  address   = "Abingdon",
  volume    =  33,
  number    =  3,
  pages     = "481--509",
  abstract  = "The fear of crime is generally considered as a social ill that
               undermines dimensions of individual well-being. Prior research
               generally specifies the fear of crime as an outcome variable in
               order to understand its complex etiology. More recently, however,
               researchers have suggested fear has a deterrence function whereby
               it reduces individuals’ involvement in violent encounters. This
               notion could hold important clues to understand the social
               sources of violence. We examine whether the fear of crime
               inhibits involvement in violent encounters, both as offender or
               victim, and if adjustments in routine activities explain these
