@ARTICLE{Mankowski2011-Interdisciplinary_Linkage_Of_Community_Psychology_And_Cross-cultural_Psychology_History_Values_And_An_Illustrative_Research_And_Action_Project_On_Intimate_Partner_Violence-..-ue,
