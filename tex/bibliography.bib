  author    = "Caughy, Margaret O'brien and O'Campo, Patricia J",
  journal   = "American journal of community psychology",
  publisher = "Wiley",
  volume    =  37,
  number    = "1-2",
  pages     = "141--154",
  abstract  = "In this investigation, we examine the impact of the ecological
               context of the residential neighborhood on the cognitive
               development of children by considering social processes not only
               at the family-level but also at the neighborhood-level. In a
               socioeconomically diverse sample of 200 African American children
