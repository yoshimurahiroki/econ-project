  language  = "en"
}

@ARTICLE{De_Veer2022-How_Do_Schoolchildren_Perceive_Litter_Overlooked_In_Urban_But_Not_In_Natural_Environments-..-qz,
  title     = "How do schoolchildren perceive litter? Overlooked in urban but
