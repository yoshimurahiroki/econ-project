  year      =  2023,
  keywords  = "Multivariate Student-t distribution; Robust filtering; SAR
               models; Spontaneous; activations; fMRI",
  language  = "en"
}

@ARTICLE{Wang2013-Robust_Variable_Selection_With_Exponential_Squared_Loss-..-zn,
  title     = "Robust variable selection with exponential squared loss",
  author    = "Wang, Xueqin and Jiang, Yunlu and Huang, Mian and Zhang, Heping",
