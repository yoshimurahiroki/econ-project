  keywords  = "",
  language  = "en"
}

@ARTICLE{Fischer2013-Why_Do_Individuals_Respond_To_Fraudulent_Scam_Communications_And_Lose_Money_The_Psychological_Determinants_Of_Scam_Compliance_The_Psychology_Of_Scams-..-qk,
