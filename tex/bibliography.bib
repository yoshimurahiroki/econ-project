@ARTICLE{Zeng2022-Internet_Governance_Through_Site_Shutdowns_The_Impact_Of_Shutting_Down_Two_Major_Commercial_Sex_Advertising_Sites-..-ic,
  title     = "Internet governance through site shutdowns: The impact of
