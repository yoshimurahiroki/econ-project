@ARTICLE{Lowenkamp2003-Replicating_Sampson_And_Grovess_Test_Of_Social_Disorganization_Theory_Revisiting_A_Criminological_Classic-..-pg,
  title     = "Replicating Sampson and Groves's test of social disorganization
