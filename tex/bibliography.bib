@ARTICLE{Arietti2024-Do_Real-time_Crime_Centers_Improve_Case_Clearance_An_Examination_Of_Chicagos_Strategic_Decision_Support_Centers-..-wv,
  title     = "Do real-time crime centers improve case clearance? An examination
