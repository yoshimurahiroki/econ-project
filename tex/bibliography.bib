@ARTICLE{Umbach2017-Aggression_And_Sleep_A_Daylight_Saving_Time_Natural_Experiment_On_The_Effect_Of_Mild_Sleep_Loss_And_Gain_On_Assaults-..-pe,
  title     = "Aggression and sleep: a daylight saving time natural experiment
