@ARTICLE{Pinotti2015-The_Economic_Costs_Of_Organised_Crime_Evidence_From_Southern_Italy-..-lq,
  title     = "The economic costs of organised crime: Evidence from southern
               Italy",
  author    = "Pinotti, Paolo",
  journal   = "Economic journal (London, England)",
