@ARTICLE{Urban1972-Federal_Regulation_Of_Whiskey_Labelling_From_The_Repeal_Of_Prohibition_To_The_Present-..-lr,
  title     = "Federal regulation of whiskey labelling: From the repeal of
               prohibition to the present",
  author    = "Urban, Raymond and Mancke, Richard",
  journal   = "The journal of law \& economics",
  publisher = "University of Chicago Press",
  volume    =  15,
  number    =  2,
  pages     = "411--426",
  abstract  = "THE current interest in consumerism coincides with renewed
               efforts by ``consumer-representatives'' to eliminate deceptive
               selling practices. Two popular methods for correcting these
               abuses have been to attempt to persuade legislatures to pass
               consumer-protection laws or to attempt to persuade regulatory
               agencies to enforce existing consumer-protection laws more
               rigorously. Both of these methods have already been used
               ``successfully'' many times in the United States. Therefore,
               before acceding to pleas for additional consumer-protection laws
               and regulations, it ought to be useful to examine the
               consequences of enforcement of some of these earlier laws and
               regulations. This paper presents a case study of the consequences
               of an earlier ``successful'' attempt to pass and enforce
               consumer-protection legislation, that is, the federal regulation
               of whiskey labelling. The study has three parts. Part I describes
               the alleged reasons for regulating whiskey labelling and the
               initial response of the legislature. Part II assesses the impact
               of the regulations actually promulgated. It concludes that,
               contrary to the legislators' publicly expressed intentions to
               pass a law that would prevent fraud and promote competition, this
               legislation actually encouraged deception of consumers and
               created entry barriers that restricted the range of available
               whiskey products. Moreover, these perverse results occurred even
               though (because of the tragic failure of nationwide Prohibition)
               both regulations and regulators were under close and continuous
               public scrutiny. Part III speculates about reasons why this
               regulation might have been instituted. It concludes by suggesting
               that once account is taken of these, the results of the
               regulation no longer seem so perverse. Indeed, they may have
               actually been intended.",
  month     =  oct,
  year      =  1972
}

@ARTICLE{Yang2008-Integrity_For_Hire_An_Analysis_Of_A_Widespread_Customs_Reform-..-ts,
  title     = "Integrity for hire: An analysis of a widespread customs reform",
  author    = "Yang, Dean",
  journal   = "The journal of law \& economics",
  publisher = "University of Chicago Press",
  volume    =  51,
  number    =  1,
  pages     = "25--57",
  abstract  = "Can governments improve bureaucratic performance by “hiring
               integrity” from the private sector? In the past 2 decades, a
               number of developing countries have hired private firms to
               conduct preshipment inspections of imports, generating
               independent data on the value and tariff classification of
               incoming shipments. I find that countries implementing such
               inspection programs subsequently experience large increases in
               import duty collections. By contrast, the growth rate of other
               tax revenues does not change appreciably. Additional evidence
               suggests that declines in falsification of import documentation
               are behind the import duty improvements; the programs also lead
               to declines in undervaluation and misreporting of goods
               classifications. Historically, this hired integrity appears to
               have been cost‐effective, with improvements in import duty
