}

@ARTICLE{Loukaitou-Sideris2009-Addressing_Womens_Fear_Of_Victimization_In_Transportation_Settings_A_Survey_Of_U_S_Transit_Agencies-..-lz,
  title     = "Addressing women's fear of victimization in transportation
