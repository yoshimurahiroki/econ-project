@ARTICLE{Situ2024-From_Mobility_To_Crime_Collective_Patterns_Of_Human_Mobility_And_Gun_Violence_In_Baltimore_City-..-yv,
  title     = "From mobility to crime: Collective patterns of human mobility and
               gun violence in Baltimore City",
  author    = "Situ, Xinyi",
  journal   = "Journal of criminal justice",
  publisher = "Elsevier BV",
  volume    =  94,
  number    =  102256,
  pages     =  102256,
  abstract  = "Purpose: In this research, I investigated the link between
               collective mobility patterns—specifically inward population flow
               and residential mobility—and changes in reported gun violence
               incidents in Baltimore City. I also examined whether this
               relationship differs among various types of gun violence.
               Furthermore, I explored the potential moderating influence of
               collective mobility patterns on the relationship between
               neighborhood hotspot coverage and occurrences of gun violence.
               Methods: The data were sourced from a blend of mobile device
               location data, Part 1 crime data from the Baltimore Police
               Department, the American Community Survey, and the zoning map of
               Baltimore. I used Poisson regression with Moran Eigenvector
               Spatial Filtering (MESF) for the analysis. Results: Inward
               population flow consistently exhibited a positive relationship
               with gun violence regardless of its subtype, whereas residential
               mobility demonstrated significant influence primarily on
               firearm-related robbery incidents. Moderation analysis indicated
               that depending on the type of gun violence being assessed, either
               inward population flow or residential mobility could attenuate
               its association with neighborhoods' crime hotspot coverage.
               Conclusions: Understanding collective mobility patterns is
               crucial for comprehending the spread of gun violence. Such
               insights can assist law enforcement agencies in refining hotspot
               policing strategies and adapting police tactics accordingly.",
  month     =  sep,
  year      =  2024,
  keywords  = "Hotspot; Violence; Mobility; Population; Firearm",
  language  = "en"
}

@ARTICLE{Testa2020-Criminal_Offending_And_Health_Over_The_Life-course_A_Dual-trajectory_Approach-..-nn,
  title     = "Criminal offending and health over the life-course: A
               dual-trajectory approach",
  author    = "Testa, Alexander and Semenza, Daniel",
  journal   = "Journal of criminal justice",
  publisher = "Elsevier BV",
  volume    =  68,
  number    =  101691,
  pages     =  101691,
  abstract  = "Despite a growth of research on the intersection of health and
               crime, limited work investigates this relationship as it evolves
               over the life-course. Drawing on data from four waves of the
               National Longitudinal Study of Adolescent to Adult Health (N =
               9037), the current study uses dual group-based trajectory
               modeling to investigate the joint development of criminal
               offending, physical health, and mental well-being from
               adolescence into young adulthood (ages 11–32). Further,
               multinomial logistic regression is employed to determine common
               sociodemographic, personality, and behavioral factors associated
               with multiple trajectories. Study findings suggest that
               individuals who persistently offend at higher rates are more
               likely to experience worse overall health and more depressive
               symptoms, whereas the lowest rate offenders have substantially
               lower likelihoods of physical and mental health problems. Several
               theoretically relevant characteristics including being male, low
               self-control, adolescent academic performance, and illicit drug
               use in adolescence predict membership in trajectories
               characterized by higher rates of offending and lower quality
               health. Theoretical and policy implications of these findings are
               discussed in the context of extant literature.",
  month     =  may,
  year      =  2020,
  keywords  = "Criminal offending; Health; Group-based trajectory modeling;
               Life-course",
  language  = "en"
}

@ARTICLE{Fitterer2015-A_Review_Of_The_Statistical_And_Quantitative_Methods_Used_To_Study_Alcohol-attributable_Crime-..-mn,
  title     = "A review of the statistical and quantitative methods used to
               study alcohol-attributable crime",
  author    = "Fitterer, Jessica L and Nelson, Trisalyn A",
  journal   = "PloS one",
  publisher = "Public Library of Science",
  address   = "United States",
  volume    =  10,
  number    =  9,
  pages     = "e0139344",
  abstract  = "Modelling the relationship between alcohol consumption and crime
               generates new knowledge for crime prevention strategies. Advances
               in data, particularly data with spatial and temporal attributes,
               have led to a growing suite of applied methods for modelling. In
               support of alcohol and crime researchers we synthesized and
               critiqued existing methods of spatially and quantitatively
               modelling the effects of alcohol exposure on crime to aid method
               selection, and identify new opportunities for analysis
               strategies. We searched the alcohol-crime literature from 1950 to
               January 2014. Analyses that statistically evaluated or mapped the
               association between alcohol and crime were included. For
               modelling purposes, crime data were most often derived from
               generalized police reports, aggregated to large spatial units
               such as census tracts or postal codes, and standardized by
               residential population data. Sixty-eight of the 90 selected
               studies included geospatial data of which 48 used cross-sectional
               datasets. Regression was the prominent modelling choice (n = 78)
               though dependent on data many variations existed. There are
               opportunities to improve information for alcohol-attributable
               crime prevention by using alternative population data to
               standardize crime rates, sourcing crime information from
               non-traditional platforms (social media), increasing the number
               of panel studies, and conducting analysis at the local level
               (neighbourhood, block, or point). Due to the spatio-temporal
               advances in crime data, we expect a continued uptake of flexible
               Bayesian hierarchical modelling, a greater inclusion of
               spatial-temporal point pattern analysis, and shift toward
               prospective (forecast) modelling over small areas (e.g., blocks).",
