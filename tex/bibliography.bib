  author    = "Thomas, Jason M and Ursell, Amanda and Robinson, Eric L and
               Aveyard, Paul and Jebb, Susan A and Herman, C Peter and Higgs,
               Suzanne",
  journal   = "Health psychology: official journal of the Division of Health
