@ARTICLE{Robitaille2021-Increasing_Organ_Donor_Registrations_With_Behavioral_Interventions_A_Field_Experiment-..-xv,
  title     = "Increasing organ donor registrations with behavioral
               interventions: A field experiment",
  author    = "Robitaille, Nicole and Mazar, Nina and Tsai, Claire I and Haviv,
