  language  = "en"
}

@ARTICLE{Jaskiewicz2018-Perceived_Neighborhood_Disorder_And_Quality_Of_Life_The_Role_Of_The_Human-place_Bond_Social_Interactions_And_Out-group_Blaming-..-ku,
  title     = "Perceived neighborhood disorder and quality of life: The role of
