@ARTICLE{Guo2020-Impact_Of_Information_Seeking_Disaster_Preparedness_And_Typhoon_Emergency_Response_On_Perceived_Community_Resilience_In_Hong_Kong-..-kn,
  title     = "Impact of information seeking, disaster preparedness and typhoon
               emergency response on perceived community resilience in Hong Kong",
