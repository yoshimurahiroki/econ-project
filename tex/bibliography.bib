@ARTICLE{Chan2022-Bridging_The_Gap_The_Predictive_Roles_Of_Emotion_Dysregulation_And_Stalking-related_Attitudes_On_Offline_And_Online_Stalking_And_Intrusive_Harassment-..-qb,
  title     = "Bridging the gap: The predictive roles of emotion dysregulation
