@ARTICLE{Jeronimo2011-Risks_Alternative_Knowledge_Strategies_And_Democratic_Legitimacy_The_Conflict_Over_Co-incineration_Of_Hazardous_Industrial_Waste_In_Portugal-..-ce,
  title     = "Risks, alternative knowledge strategies and democratic
