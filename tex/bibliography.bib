@ARTICLE{Wu2012-Trust_In_Police_A_Comparison_Of_China_And_Taiwan-..-yu,
  title     = "Trust in police: A comparison of China and Taiwan",
  author    = "Wu, Yuning and Poteyeva, Margarita and Sun, Ivan Y",
  journal   = "International journal of comparative and applied criminal justice",
  publisher = "Informa UK Limited",
  volume    =  36,
  number    =  3,
  pages     = "189--210",
  abstract  = "Public trust has become a critical issue in transitional
               societies, such as China and Taiwan, where the legitimacy and
               accountability of the government in general, and legal
               authorities in particular, have been frequently scrutinized.
               Based on nationwide random samples, this study tests the
               explanatory power of three theories, the social structural
               thesis, the institutional performance thesis, and the cultural
               thesis, in accounting for public trust in police in China and
               Taiwan. Results show that Chinese citizens have higher levels of
               trust in police than do Taiwanese. The higher level of Chinese
               trust, to a large extent, derives from greater confidence in
               macroeconomic conditions and satisfaction with government
               responsiveness. The performance thesis, thus, receives the
               strongest support. Results also show some support for the
               cultural perspective that traditional values, such as
               interpersonal trust, promote trust in police in both societies.
               Policy implications are provided for enhancing police legitimacy
               and facilitating police reform in China and Taiwan.",
  month     =  aug,
