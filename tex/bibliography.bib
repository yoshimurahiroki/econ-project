}

@ARTICLE{Bhattacharya2004-Poverty_Food_Insecurity_And_Nutritional_Outcomes_In_Children_And_Adults-..-nt,
  title     = "Poverty, food insecurity, and nutritional outcomes in children
               and adults",
  author    = "Bhattacharya, Jayanta and Currie, Janet and Haider, Steven",
  journal   = "Journal of health economics",
  publisher = "Elsevier BV",
  volume    =  23,
  number    =  4,
  pages     = "839--862",
  abstract  = "Using data from the National Health and Nutrition Examination
               Survey, we examine the relationship between nutritional status,
               poverty, and food insecurity for household members of various
               ages. Our most striking result is that, while poverty is
               predictive of poor nutrition among preschool children, food
               insecurity does not provide any additional predictive power for
               this age group. Among school age children, neither poverty nor
               food insecurity is associated with nutritional outcomes, while
               among adults and the elderly, both food insecurity and poverty
