@ARTICLE{Manica2021-Impact_Of_Tiered_Restrictions_On_Human_Activities_And_The_Epidemiology_Of_The_Second_Wave_Of_COVID-19_In_Italy-..-iz,
  title     = "Impact of tiered restrictions on human activities and the
