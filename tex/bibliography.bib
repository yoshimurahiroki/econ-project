@ARTICLE{Karakus2011-Public_Satisfaction_With_Law_Enforcement_In_Turkey-..-jv,
  title     = "Public satisfaction with law enforcement in Turkey",
  author    = "Karakus, Onder and McGarrell, Edmund F and Basibuyuk, Oguzhan",
  journal   = "Policing (Bradford, England)",
