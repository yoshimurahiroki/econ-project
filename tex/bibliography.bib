@ARTICLE{Holz2023-Peer_Effects_In_Police_Use_Of_Force-..-cs,
  title     = "Peer effects in police use of force",
  author    = "Holz, Justin E and Rivera, Roman G and Ba, Bocar A",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  15,
  number    =  2,
  pages     = "256--291",
  abstract  = "We study the link between police officers’ on-duty injuries and
               their peers’ force use using a network of officers who attended
               the police academy together through a random lottery. On-duty
               injuries increase the probability of officers using force by 7
               percent in the subsequent week. Officers are also more likely to
               injure suspects and receive complaints about neglecting victims
