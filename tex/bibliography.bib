@ARTICLE{McCarthy2022-Exploring_Trajectories_Of_Offender_Harm_An_Alternative_Approach_To_Understanding_Offending_Pathways_Over_The_Life-course-..-cj,
  title     = "Exploring trajectories of offender harm: An alternative approach
