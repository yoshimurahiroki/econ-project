@ARTICLE{Flynn2009-Money_Can_t_Buy_Love_Asymmetric_Beliefs_About_Gift_Price_And_Feelings_Of_Appreciation-..-xa,
  title     = "Money can’t buy love: Asymmetric beliefs about gift price and
