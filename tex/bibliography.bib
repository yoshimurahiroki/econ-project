@ARTICLE{Land1991-Characteristics_Of_U_S_Cities_With_Extreme_high_Or_Low_Crime_Rates_Results_Of_Discriminant_Analyses_Of_1960_1970_And_1980_Data-..-cn,
  title     = "Characteristics of {U}.{S}. cities with extreme (high or low)
