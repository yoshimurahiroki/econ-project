  keywords  = "COVID-19; Delinquency; Juvenile justice; Juvenile justice
               reform",
  language  = "en"
}

@ARTICLE{Mezey2002-Redefining_Intimate_Partner_Violence_Women_s_Experiences_With_Physical_Violence_And_Non-physical_Abuse_By_Age-..-zv,
