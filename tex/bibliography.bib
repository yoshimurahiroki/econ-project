  year      =  2019,
  language  = "en"
}

@ARTICLE{Bindler2018-How_Punishment_Severity_Affects_Jury_Verdicts_Evidence_From_Two_Natural_Experiments-..-dc,
  title     = "How punishment severity affects jury verdicts: Evidence from two
