@ARTICLE{Mukherjee2024-Uncovering_Spatial_Patterns_Of_Crime_A_Case_Study_Of_Kolkata-..-ne,
  title     = "Uncovering spatial patterns of crime: a case study of Kolkata",
  author    = "Mukherjee, Kasturi and Saha, Sumana and Karmakar, Supratim and
