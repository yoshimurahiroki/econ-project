  language  = "en"
}

@ARTICLE{Jones2012-Primary_Prevention_And_Health_Outcomes_Treatment_Of_Residential_Lead-based_Paint_Hazards_And_The_Prevalence_Of_Childhood_Lead_Poisoning-..-hq,
  title     = "Primary prevention and health outcomes: Treatment of residential
               lead-based paint hazards and the prevalence of childhood lead
