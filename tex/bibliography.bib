@ARTICLE{Katz2003-Prison_Conditions_Capital_Punishment_And_Deterrence-..-bt,
  title     = "Prison Conditions, Capital Punishment, and Deterrence",
  author    = "Katz, L",
  journal   = "American law and economics review",
  publisher = "Oxford University Press (OUP)",
  volume    =  5,
  number    =  2,
  pages     = "318--343",
  abstract  = "Previous research has attempted to identify a deterrent effect of
               capital punishment. We argue that the quality of life in prison
               is likely to have a greater impact on criminal behavior than the
               death penalty. Using state-level panel data covering the period
               1950--90, we demonstrate that the death rate among prisoners (the
               best available proxy for prison conditions) is negatively
               correlated with crime rates, consistent with deterrence. This
               finding is shown to be quite robust. In contrast, there is little
               systematic evidence that the execution rate influences crime
               rates in this time period. Copyright 2003, Oxford University
               Press.",
