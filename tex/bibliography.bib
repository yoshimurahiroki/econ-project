@ARTICLE{Saiz2011-Immigration_And_The_Neighborhood-..-xg,
  title     = "Immigration and the neighborhood",
  author    = "Saiz, Albert and Wachter, Susan",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  3,
  number    =  2,
  pages     = "169--188",
  abstract  = "Within metropolitan areas, neighborhoods of growing immigrant
               settlement are becoming relatively less desirable to natives. We
               deploy a geographic diffusion model to instrument for the growth
               of immigrant density in a neighborhood. Our approach deals
               explicitly with potential unobservable shocks that may be
               correlated with proximity to immigrant enclaves. The evidence is
