}

@ARTICLE{Browning2013-The_Social_Ecology_Of_Public_Space_Active_Streets_And_Violent_Crime_In_Urban_Neighborhoods_The_Social_Ecology_Of_Public_Space-..-mk,
  title     = "The social ecology of public space: Active streets and violent
