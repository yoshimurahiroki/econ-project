@ARTICLE{Depetris-Chauvin2020-Building_Nations_Through_Shared_Experiences_Evidence_From_African_Football-..-pt,
  title     = "Building Nations through shared experiences: Evidence from
               African football",
  author    = "Depetris-Chauvin, Emilio and Durante, Ruben and Campante, Filipe",
  journal   = "American Economic Review",
  publisher = "American Economic Association",
  volume    =  110,
  number    =  5,
  pages     = "1572--1602",
  abstract  = "We examine whether shared collective experiences help build a
               national identity, by looking at the impact of national football
               teams’ victories in sub-Saharan Africa. We find that individuals
               surveyed in the days after an important victory of their
               country’s national team are 37 percent less likely to identify
               primarily with their ethnic group, and 30 percent more likely to
