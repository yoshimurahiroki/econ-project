@ARTICLE{Dustmann2024-Refugee_Benefit_Cuts-..-vs,
  title     = "Refugee benefit cuts",
  author    = "Dustmann, Christian and Landersø, Rasmus and Andersen, Lars
               Højsgaard",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  16,
  number    =  2,
  pages     = "406--441",
  abstract  = "This paper analyzes the effects of Denmark’s Start Aid welfare
               reform that targets refugees. Implemented in 2002, it enables us
               to study not only the reform’s immediate effects but also its
               longer-term consequences and its repeal a decade later. The
