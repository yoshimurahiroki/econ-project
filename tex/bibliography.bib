@ARTICLE{Reischl2016-Assessing_Physical_Disorder_In_Urban_Neighborhoods_Reliability_And_Validity_Of_The_Parcel_Maintenance_Observation_Tool_Assessing_Physical_Disorder_In_Urban_Neighborhoods-..-dj,
