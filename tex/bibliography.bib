@ARTICLE{Alon-Barkat2020-Can_Government_Public_Communications_Elicit_Undue_Trust_Exploring_The_Interaction_Between_Symbols_And_Substantive_Information_In_Communications-..-ic,
  title     = "Can government public communications elicit undue trust?
