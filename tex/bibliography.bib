@ARTICLE{Oberwittler2004-A_Multilevel_Analysis_Of_Neighbourhood_Contextual_Effects_On_Serious_Juvenile_Offending_The_Role_Of_Subcultural_Values_And_Social_Disorganization-..-dp,
