}

@ARTICLE{Brenner2013-Neighborhood_Context_And_Perceptions_Of_Stress_Over_Time_An_Ecological_Model_Of_Neighborhood_Stressors_And_Intrapersonal_And_Interpersonal_Resources-..-gb,
