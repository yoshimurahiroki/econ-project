               on-label. This paper was accepted by Eric Anderson, marketing.",
  month     =  dec,
  year      =  2018,
  language  = "en"
}

@ARTICLE{Simms1991-An_Information_Processing_Model_Of_A_Police_Organization-..-mp,
  title     = "An information processing model of a police organization",
  author    = "Simms, B W and Petersen, E R",
  journal   = "Management science",
  publisher = "Institute for Operations Research and the Management Sciences
               (INFORMS)",
  volume    =  37,
  number    =  2,
  pages     = "216--232",
  abstract  = "A model has been developed to study economic decision making in
               police organizations. The conceptual viewpoint taken is that
               police organizations are information processing systems, with
               activities connected in a communication network. The resulting
               model is process-oriented, and organizational decisions are
               analyzed by studying how the police force senses, learns about,
