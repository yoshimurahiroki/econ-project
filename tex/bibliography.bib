  language  = "en"
}

@ARTICLE{Hayes2016-Impact_Of_Victim_Offender_And_Relationship_Characteristics_On_Frequency_And_Timing_Of_Intimate_Partner_Violence_Using_Life_History_Calendar_Data-..-il,
