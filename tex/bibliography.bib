@ARTICLE{Brunsdon2022-Unveiling_The_Relationship_Between_Land_Use_Types_And_The_Temporal_Signals_Of_Crime_An_Empirical_Decomposition_Approach-..-vl,
  title     = "Unveiling the relationship between land use types and the
