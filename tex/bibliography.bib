  journal   = "American Economic Review",
  publisher = "American Economic Association",
  volume    =  112,
  number    =  2,
  pages     = "442--493",
  abstract  = "We study how political turnover in mayoral elections in Brazil
               affects public service provision by local governments. Exploiting
               a regression discontinuity design for close elections, we find
               that municipalities with a new party in office experience
               upheavals in the municipal bureaucracy: new personnel are
