@ARTICLE{Braga2014-The_Effects_Of_Hot_Spots_Policing_On_Crime_An_Updated_Systematic_Review_And_Meta-analysis-..-hs,
  title     = "The effects of hot spots policing on crime: An updated systematic
               review and meta-analysis",
  author    = "Braga, Anthony A and Papachristos, Andrew V and Hureau, David M",
