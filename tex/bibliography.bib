@ARTICLE{Phillips1977-CMC_Heller_Hunt_FIA_FRA_And_FINE_The_Neglected_Aspect_Of_Financial_Reform-..-kc,
  title     = "{CMC}, Heller, hunt, {FIA}, {FRA}, and {FINE}: The neglected
