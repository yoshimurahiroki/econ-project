@ARTICLE{Perez_Esparza2020-Why_Did_Mexico_Become_A_Violent_Country_Assessing_The_Role_Of_Firearms_Trafficked_From_The_U_S-..-xu,
  title     = "Why did Mexico become a violent country?: Assessing the role of
