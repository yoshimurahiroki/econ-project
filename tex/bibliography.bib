@ARTICLE{Schrag1994-Crime_And_Prejudice_The_Use_Of_Character_Evidence_In_Criminal_Trials-..-af,
  title     = "Crime and prejudice: The use of character evidence in criminal
               trials",
  author    = "Schrag, Joel and Scotchmer, Suzanne",
  journal   = "Journal of law, economics, \& organization",
  publisher = "Oxford University Press (OUP)",
  volume    =  10,
  number    =  2,
  pages     = "319--342",
  abstract  = "The task of juries is to dispense ex post justice. While justice
               requires convicting the guilty and acquitting the innocent, the
               evidence usually cannot distinguish with certainty. We argue that
               the jury will be more lenient in acquittals than is optimal for
               deterring crime whenever its subjective cost of wrongful
               convictions is at least as high as its subjective cost of
               wrongful acquittals. However if the jury is prejudiced against
               habitual criminals, its subjective cost of wrongful convictions
               will be relatively low, and then the jury may impede deterrence
