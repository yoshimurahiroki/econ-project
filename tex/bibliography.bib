@ARTICLE{Bateson2013-Do_Images_Of_Watching_Eyes_Induce_Behaviour_That_Is_More_Pro-social_Or_More_Normative_A_Field_Experiment_On_Littering-..-zy,
  title     = "Do images of 'watching eyes' induce behaviour that is more
               pro-social or more normative? A field experiment on littering",
  author    = "Bateson, Melissa and Callow, Luke and Holmes, Jessica R and
