@ARTICLE{Homonoff2021-Program_Recertification_Costs_Evidence_From_SNAP-..-up,
  title     = "Program recertification costs: Evidence from {SNAP}",
  author    = "Homonoff, Tatiana and Somerville, Jason",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  13,
  number    =  4,
  pages     = "271--298",
  abstract  = "Participants in means-tested programs must periodically document
               eligibility through a recertification process. If all cases that
               fail recertification are ineligible, the exact timing of this
               process should be irrelevant. We find that later recertification
               interview assignments for the Supplemental Nutrition Assistance
               Program (SNAP), which leave less time to reschedule missed
