@ARTICLE{Baranauskas2018-Media_Construction_Of_Crime_Revisited_Media_Types_Consumer_Contexts_And_Frames_Of_Crime_And_Justice_Media_Construction_Of_Crime_Revisited-..-iq,
  title     = "Media construction of crime revisited: Media types, consumer
