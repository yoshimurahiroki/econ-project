@ARTICLE{Helsley2014-Social_Networks_And_Interactions_In_Cities-..-hv,
  title     = "Social networks and interactions in cities",
  author    = "Helsley, Robert W and Zenou, Yves",
  journal   = "Journal of Economic Theory",
  publisher = "Elsevier BV",
  volume    =  150,
  pages     = "426--466",
  abstract  = "We examine how interaction choices depend on the interplay of
               social and physical distance, and show that agents who are more
               central in the social network, or are located closer to the
               geographic center of interaction, choose higher levels of
               interactions in equilibrium. As a result, the level of
