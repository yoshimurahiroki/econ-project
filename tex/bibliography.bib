@ARTICLE{Chen2021-Quantile_Factor_Models-..-qd,
  title     = "Quantile factor models",
  author    = "Chen, Liang and Dolado, Juan J and Gonzalo, Jesús",
  journal   = "Econometrica: journal of the Econometric Society",
