@ARTICLE{White2016-Federal_Civil_Litigation_As_An_Instrument_Of_Police_Reform_A_Natural_Experiment_Exploring_The_Effects_Of_The_Floyd_Ruling_On_Stop-and-frisk_Activities_In_New_York_City-..-zd,
