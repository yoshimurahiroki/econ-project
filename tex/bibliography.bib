@ARTICLE{Moore2014-Psychological_Resilience_The_Impact_Of_Affectivity_And_Coping_On_State_Anxiety_And_Positive_Emotions_During_And_After_The_Washington_DC_Sniper_Killings-..-hg,
  title     = "Psychological resilience: the impact of affectivity and coping on
