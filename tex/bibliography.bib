  year      =  2006,
  keywords  = "heuristics; risk communication; fear affects; risk perception;
               floor risk; Communication; Emotional States; Fear; Natural
               Disasters",
  language  = "en"
}

@ARTICLE{Gruev-Vintila2007-Social_Thinking_About_Collective_Risk_How_Do_Risk-related_Practice_And_Personal_Involvement_Impact_Its_Social_Representations_-..-oz,
