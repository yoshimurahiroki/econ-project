  year      =  2007,
  keywords  = "",
  language  = "en"
}

@ARTICLE{Zhang2021-Measurement_Of_Potential_Victims_Of_Burglary_At_The_Mesoscale_Comparison_Of_Census_Phone_Users_And_Social_Media_Data-..-mi,
