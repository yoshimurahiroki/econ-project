@ARTICLE{Budish2023-Primary-market_Auctions_For_Event_Tickets_Eliminating_The_Rents_Of_bob_The_Broker_-..-vq,
  title     = "Primary-market auctions for event tickets: Eliminating the rents
               of “bob the broker”?",
  author    = "Budish, Eric and Bhave, Aditya",
  journal   = "American Economic Journal. Microeconomics",
  publisher = "American Economic Association",
  volume    =  15,
  number    =  1,
  pages     = "142--170",
  abstract  = "Economists have long been puzzled by event-ticket underpricing:
               underpricing reduces revenue for the performer and encourages
               socially wasteful rent-seeking by ticket brokers. What about
               using an auction? This paper studies the introduction of auctions
               into this market by Ticketmaster in the mid-2000s. By combining
               primary-market auction data from Ticketmaster with
               secondary-market resale value data from eBay, we show that
               Ticketmaster’s auctions “worked”: they substantially improved
               price discovery, roughly doubled performer revenues, and, on
               average, nearly eliminated the potential arbitrage profits
               associated with underpriced tickets. We conclude by discussing
               why, nevertheless, the auctions failed to take off. (JEL D44,
               D47, L82)",
  month     =  feb,
  year      =  2023,
  language  = "en"
}

@ARTICLE{Swank2015-Learning_From_Others_Decision_Rights_Strategic_Communication_And_Reputational_Concerns-..-dn,
