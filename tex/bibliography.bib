  language  = "en"
}

@ARTICLE{Rosenthal2008-The_Attenuation_Of_Human_Capital_Spillovers-..-mc,
  title     = "The attenuation of human capital spillovers",
  author    = "Rosenthal, Stuart S and Strange, William C",
  journal   = "Journal of urban economics",
  publisher = "Elsevier BV",
  volume    =  64,
  number    =  2,
  pages     = "373--389",
  abstract  = "This paper uses 2000 Census data to estimate the relationship of
               agglomeration and proximity to human capital to wages. The paper
               takes a geographic approach, and focuses on the attenuation of
               agglomeration and human capital effects. Differencing and
               instrumental variable methods are employed to address endogeneity
               in the wage–agglomeration relationship and also to deal with
