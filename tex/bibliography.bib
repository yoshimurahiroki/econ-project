@ARTICLE{Gautier2009-Terrorism_And_Attitudes_Towards_Minorities_The_Effect_Of_The_Theo_Van_Gogh_Murder_On_House_Prices_In_Amsterdam-..-ss,
  title     = "Terrorism and attitudes towards minorities: The effect of the
               Theo van Gogh murder on house prices in Amsterdam",
  author    = "Gautier, Pieter A and Siegmann, Arjen and Van Vuuren, Aico",
  journal   = "Journal of urban economics",
  publisher = "Elsevier BV",
  volume    =  65,
  number    =  2,
  pages     = "113--126",
  abstract  = "Does fundamentalist-Islamic terrorism have an effect on the
               general attitudes towards Muslim minorities? We use the murder of
               Theo van Gogh as an event study to address this question.
               Specifically, we use the hedonic-market model and test for an
               effect on listed house prices in neighborhoods where more than
               25\% of the people belong to an ethnic minority from a Muslim
               country (type I). Relative to the other neighborhoods, house
               prices in type I neighborhoods decreased in 10 months by about
               3\%, with a widening gap over time. Our results are robust to
