@ARTICLE{Nataraj-Hansen2024-_Should_ve_Known_Better_Using_Lerner_s_Belief_In_A_Just_World_To_Understand_How_The_Fraud_Justice_Network_Observe_Victims_Of_Online_Romance_And_Investment_Frauds-..-fk,
