  language  = "en"
}

@ARTICLE{Allcott2019-Food_Deserts_And_The_Causes_Of_Nutritional_Inequality-..-xj,
  title     = "Food deserts and the causes of nutritional inequality",
  author    = "Allcott, Hunt and Diamond, Rebecca and Dubé, Jean-Pierre and
