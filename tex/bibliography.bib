@ARTICLE{Weisburd2014-Understanding_And_Controlling_Hot_Spots_Of_Crime_The_Importance_Of_Formal_And_Informal_Social_Controls-..-yl,
  title     = "Understanding and controlling hot spots of crime: the importance
               of formal and informal social controls",
  author    = "Weisburd, David and Groff, Elizabeth R and Yang, Sue-Ming",
  journal   = "Prevention science: the official journal of the Society for
