@ARTICLE{Mazerolle2023-Partnership_Approaches_In_Policing_An_Analysis_Of_Different_Types_Of_Partnerships_And_How_They_Work_To_Reduce_Crime_And_Disorder-..-zw,
  title     = "Partnership approaches in policing: An analysis of different
               types of partnerships and how they work to reduce crime and
