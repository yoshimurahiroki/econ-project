@ARTICLE{Gamba2018-Corruption_Organized_Crime_And_The_Bright_Side_Of_Subversion_Of_Law-..-yw,
  title     = "Corruption, organized crime and the bright side of subversion of
               law",
  author    = "Gamba, Astrid and Immordino, Giovanni and Piccolo, Salvatore",
  journal   = "Journal of public economics",
  publisher = "Elsevier BV",
  volume    =  159,
  pages     = "79--88",
  abstract  = "We study an enforcement model in which, as soon as a Legislator
               grants an amnesty to low-rank criminals cooperating with the
               justice, top criminals react by bribing public officials in order
               to avoid being sanctioned. We show that, to prevent this form of
               subversion of law, the optimal policy must grant leniency not
               only to low-rank criminals but also to officials who plead guilty
