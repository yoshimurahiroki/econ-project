@ARTICLE{Di_Tella2004-Do_Police_Reduce_Crime_Estimates_Using_The_Allocation_Of_Police_Forces_After_A_Terrorist_Attack-..-nh,
  title     = "Do police reduce crime? Estimates using the allocation of police
