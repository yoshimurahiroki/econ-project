}

@ARTICLE{Baxter2009-A_Quantitative_Assessment_Of_The_Insider/outsider_Dimension_Of_The_Cultural_Theory_Of_Risk_And_Place-..-re,
  title     = "A quantitative assessment of the insider/outsider dimension of
