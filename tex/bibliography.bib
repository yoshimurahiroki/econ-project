@ARTICLE{Hubbard2015-Impact_Of_A_Smarter_Lunchroom_Intervention_On_Food_Selection_And_Consumption_Among_Adolescents_And_Young_Adults_With_Intellectual_And_Developmental_Disabilities_In_A_Residential_School_Setting-..-ko,
  title     = "Impact of a Smarter Lunchroom intervention on food selection and
