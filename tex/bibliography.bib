@ARTICLE{Gonzalez1998-Mexican_Enclaves_And_The_Price_Of_Culture-..-xu,
  title     = "Mexican enclaves and the price of culture",
  author    = "Gonzalez, Arturo",
  journal   = "Journal of urban economics",
