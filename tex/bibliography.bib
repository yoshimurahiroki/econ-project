@ARTICLE{Mark2019-What_Does_Robbery_Really_Cost_An_Exploratory_Study_Into_Calculating_Costs_And_hidden_Costs_Of_Policing_Opioid-related_Robbery_Offences-..-lo,
  title     = "What does robbery really cost? An exploratory study into
