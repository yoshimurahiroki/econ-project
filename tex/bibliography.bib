@ARTICLE{Wo2016-Voluntary_Organizations_And_Neighborhood_Crime_A_Dynamic_Perspective_Voluntary_Organizations_And_Neighborhood_Crime-..-kq,
  title     = "Voluntary organizations and neighborhood crime: A dynamic
