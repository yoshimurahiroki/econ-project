  year      =  2007,
  language  = "en"
}

@ARTICLE{Blumstein1993-Filtered_Sampling_From_Populations_With_Heterogeneous_Event_Frequencies-..-mt,
  title     = "Filtered sampling from populations with heterogeneous event
