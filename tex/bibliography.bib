@ARTICLE{Mears2012-Gender_Differences_In_The_Effects_Of_Prison_On_Recidivism-..-mf,
  title     = "Gender differences in the effects of prison on recidivism",
  author    = "Mears, Daniel P and Cochran, Joshua C and Bales, William D",
