@ARTICLE{Thulin2021-Perceived_Neighborhood_Characteristics_And_Experiences_Of_Intimate_Partner_Violence_A_Multilevel_Analysis-..-cf,
  title     = "Perceived neighborhood characteristics and experiences of
               intimate partner violence: A multilevel analysis",
  author    = "Thulin, Elyse J and Heinze, Justin E and Kusunoki, Yasamin and
