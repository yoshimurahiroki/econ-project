@ARTICLE{Mao2023-Relationship_Between_Socioeconomic_Conditions_And_Financial_Fraud_Victimization_Among_Older_Adults_In_China_Do_Financial_Literacy_And_Financial_Attitudes_Matter_-..-dp,
