@ARTICLE{van_Rijswijk2016-Safety_In_The_Eye_Of_The_Beholder_Individual_Susceptibility_To_Safety-related_Characteristics_Of_Nocturnal_Urban_Scenes-..-hd,
  title     = "Safety in the eye of the beholder: Individual susceptibility to
