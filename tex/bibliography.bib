  language  = "en"
}

@ARTICLE{Chen2020-Exploring_The_Homogeneity_Of_Theft_Offenders_In_Spatio-temporal_Crime_Hotspots-..-ve,
  title     = "Exploring the homogeneity of theft offenders in spatio-temporal
