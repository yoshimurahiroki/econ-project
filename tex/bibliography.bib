@ARTICLE{Walklate1998-Excavating_The_Fear_Of_Crime_Fear_Anxiety_Or_Trust_-..-rh,
  title     = "Excavating the fear of crime:: Fear, anxiety or trust?",
  author    = "Walklate, Sandra",
  journal   = "Theoretical criminology",
  publisher = "SAGE Publications",
  volume    =  2,
  number    =  4,
  pages     = "403--418",
  abstract  = "The central purpose of this article is to offer a critical
               examination of the fear of crime debate and to suggest a
               different conceptual framework through which what might be called
               the fear of crime might be understood. A critical appreciation of
               fear as the other, fear as rational/irrational, fear as safety
               and fear as anxiety will be offered. It will be argued that none
               of these ways of exploring the concept of fear has resonance with
               the experiences of those living in high crime areas where
               questions of trust seem to have a greater salience. Indeed it is
               through an exploration of the concept of trust, and its
               underlying generative mechanisms, here suggested as the state,
               the (dis)organization of crime, the (dis)organization of
               community and finally processes of sociability, that expressed
               concerns about crime might be better understood.",
  month     =  nov,
  year      =  1998,
  language  = "en"
}

