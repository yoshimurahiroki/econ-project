  keywords  = "",
  language  = "en"
}

@ARTICLE{Godfrey2005-Explaining_Gendered_Sentencing_Patterns_For_Violent_Men_And_Women_In_The_Late-Victorian_And_Edwardian_Period-..-es,
  title     = "Explaining gendered sentencing patterns for violent men and women
