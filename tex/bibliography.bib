@ARTICLE{Shavell1987-A_Model_Of_Optimal_Incapacitation-..-an,
  title     = "A Model of Optimal Incapacitation",
  author    = "Shavell, Steven",
  journal   = "American Economic Review",
  publisher = "The American Economic Association",
  address   = "Menasha, Wis",
  volume    =  77,
  number    =  2,
  pages     = "107--110",
  abstract  = "The incapacitative function of the criminal sanctions of
               imprisonment and the death sentence is considered using a model
               in which the amount of harm individuals cause each period that
               they are free is not influenced by the threat of sanctions. The
               model is first examined assuming that an individual's
               dangerousness remains the same each period of the individual's
               life and that the sanction is imprisonment. In this case, it is
               optimal to imprison an individual if that individual's
               dangerousness exceeds a threshold equal to the per-period cost of
               imprisonment. Furthermore, if it is optimal to imprison an
               individual at all, it will be best to do so for life. The model
               is then extended by supposing that: 1. the dangerousness of
               individuals declines with age, 2. the dangerousness of
               individuals declines with time spent in prison due to a
               rehabilitative effect, and 3. a choice can be made between
               imprisonment and the death penalty. When incapacitation is the
               goal (as opposed to deterrence), the optimal sanction is
               independent of the probability of apprehension.",
  month     =  may,
  year      =  1987,
  keywords  = "Age;Capital punishment;Criminals;Economic
               sanctions;Economics;Externalities (Economics);Imprisonment;Law
               enforcement;Law schools;Mathematical models;Prisons"
}

@ARTICLE{Wettereau1942-The_Branches_Of_The_First_Bank_Of_The_United_States-..-xh,
  title     = "The branches of the first Bank of the United States",
