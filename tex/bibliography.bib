@ARTICLE{Pikoulas2022-The_Protective_Role_Of_Self-esteem_On_Burnout_And_Depression_Symptoms_Among_Police_Officers_A_Path_Analysis_Approach-..-gn,
  title     = "The protective role of self-esteem on burnout and depression
