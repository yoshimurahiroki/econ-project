@ARTICLE{Geys2006-Looking_Across_Borders_A_Test_Of_Spatial_Policy_Interdependence_Using_Local_Government_Efficiency_Ratings-..-ge,
  title     = "Looking across borders: A test of spatial policy interdependence
               using local government efficiency ratings",
  author    = "Geys, Benny",
  journal   = "Journal of urban economics",
  publisher = "Elsevier BV",
  volume    =  60,
  number    =  3,
  pages     = "443--462",
  abstract  = "Spatial patterns in (local) government taxation and spending
               decisions have received a lot of attention. Still, the focus on
               taxation or expenditure levels in previous studies may be
               incomplete. Indeed, (rational) individuals are likely to consider
               the level of spending on (or taxation for) public goods provision
               simultaneously with how much public goods they actually
               receive—thus assessing the ‘price/quantity’ of government
               policies. Therefore, the present paper argues that incumbents may
