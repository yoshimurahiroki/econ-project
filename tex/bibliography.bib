@ARTICLE{Hahn2018-On_Recursive_Bayesian_Predictive_Distributions-..-ql,
  title     = "On recursive Bayesian predictive distributions",
  author    = "Hahn, P Richard and Martin, Ryan and Walker, Stephen G",
