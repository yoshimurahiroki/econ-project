@ARTICLE{Hakyemez2023-Putting_Spatial_Crime_Patterns_In_Their_Social_Contexts_Through_A_Contextualized_Colocation_Analysis-..-lx,
  title     = "Putting spatial crime patterns in their social contexts through a
