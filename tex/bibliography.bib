@ARTICLE{Jackson2009-Crime_Policing_And_Social_Order_On_The_Expressive_Nature_Of_Public_Confidence_In_Policing_Crime_Policing_And_Social_Order-..-mg,
  title     = "Crime, policing and social order: on the expressive nature of
