@ARTICLE{Smith2016-Spring_Forward_At_Your_Own_Risk_Daylight_Saving_Time_And_Fatal_Vehicle_Crashes-..-qb,
  title     = "Spring forward at your own risk: Daylight Saving Time and fatal
