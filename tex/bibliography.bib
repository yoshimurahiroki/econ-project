  author    = "Banerjee, Abhijit and Chattopadhyay, Raghabendra and Duflo,
               Esther and Keniston, Daniel and Singh, Nina",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  13,
  number    =  1,
  pages     = "36--66",
  abstract  = "Management matters for firms, but what practices are optimal in
