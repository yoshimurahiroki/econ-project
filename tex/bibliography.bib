@ARTICLE{Jensen2024-Do_Awareness_Campaigns_Reduce_Financial_Fraud_-..-oi,
  title     = "Do awareness campaigns reduce financial fraud?",
  author    = "Jensen, Rasmus Ingemann Tuffveson and Gerlings, Julie and
               Ferwerda, Joras",
