  month     =  mar,
  year      =  2018,
  keywords  = "",
  language  = "en"
}

@ARTICLE{O_Hara2020-Crime_Script_Analysis_For_Adult_Image-based_Sexual_Abuse_A_Study_Of_Crime_Intervention_Points_For_Retribution-style_Offenders-..-xc,
  title     = "Crime script analysis for adult image-based sexual abuse: a study
