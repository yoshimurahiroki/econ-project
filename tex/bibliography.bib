@ARTICLE{Jose2016-Intimate_Partner_Violence_Victims_Seeking_A_Temporary_Restraining_Order_Social_Support_And_Resilience_Attenuating_Psychological_Distress_Social_Support_And_Resilience_Attenuating_Psychological_-..-sa,
