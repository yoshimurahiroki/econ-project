@ARTICLE{McCoy2013-Neighborhood_Crime_And_School_Climate_As_Predictors_Of_Elementary_School_Academic_Quality_A_Cross-lagged_Panel_Analysis-..-oq,
  title     = "Neighborhood crime and school climate as predictors of elementary
               school academic quality: a cross-lagged panel analysis",
  author    = "McCoy, Dana Charles and Roy, Amanda L and Sirkman, Gabriel M",
  journal   = "American journal of community psychology",
  publisher = "Wiley",
  volume    =  52,
  number    = "1-2",
  pages     = "128--140",
  abstract  = "Past research has found negative relationships between
               neighborhood structural disadvantage and students' academic
               outcomes. Comparatively little work has evaluated the
               associations between characteristics of neighborhoods and schools
               themselves. This study explored the longitudinal, reciprocal
               relationships between neighborhood crime and school-level
               academic achievement within 500 urban schools. Results revealed
               that higher neighborhood crime (and particularly violent crime)
               predicted decreases in school academic achievement across time.
