@ARTICLE{Sommers2013-Emergency_Department-based_Brief_Intervention_To_Reduce_Risky_Driving_And_Hazardous/harmful_Drinking_In_Young_Adults_A_Randomized_Controlled_Trial-..-pi,
  title     = "Emergency department-based brief intervention to reduce risky
