  year      =  2013,
  language  = "en"
}

@ARTICLE{Baker2019-The_Long-Run_Impacts_Of_A_Universal_Child_Care_Program-..-zz,
  title     = "The Long-Run impacts of a universal child care program",
  author    = "Baker, Michael and Gruber, Jonathan and Milligan, Kevin",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  11,
  number    =  3,
  pages     = "1--26",
  abstract  = "Past research documents the persistence of positive impacts of
               early life interventions on noncognitive skills. We test the
               symmetry of this finding by studying the persistence of a
               sizeable negative shock to noncognitive outcomes arising with the
               introduction of universal child care in Quebec. We find that the
               negative effects on noncognitive outcomes persisted to school
               ages, and also that cohorts with increased child care access had
