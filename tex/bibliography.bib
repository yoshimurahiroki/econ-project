@ARTICLE{Clarke2023-Synthetic_Difference_In_Differences_Estimation-..-wb,
  title         = "Synthetic difference in differences estimation",
  author        = "Clarke, Damian and Pailañir, Daniel and Athey, Susan and
                   Imbens, Guido",
  journal       = "arXiv [econ.EM]",
  abstract      = "In this paper, we describe a computational implementation of
                   the Synthetic difference-in-differences (SDID) estimator of
                   Arkhangelsky et al. (2021) for Stata. Synthetic
                   difference-in-differences can be used in a wide class of
                   circumstances where treatment effects on some particular
                   policy or event are desired, and repeated observations on
                   treated and untreated units are available over time. We lay
                   out the theory underlying SDID, both when there is a single
                   treatment adoption date and when adoption is staggered over
                   time, and discuss estimation and inference in each of these
                   cases. We introduce the sdid command which implements these
                   methods in Stata, and provide a number of examples of use,
                   discussing estimation, inference, and visualization of
                   results.",
