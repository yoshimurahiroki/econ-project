@ARTICLE{Steinert2018-Household_Economic_Strengthening_Through_Financial_And_Psychosocial_Programming_Evidence_From_A_Field_Experiment_In_South_Africa-..-ku,
  title     = "Household economic strengthening through financial and
               psychosocial programming: Evidence from a field experiment in
               South Africa",
  author    = "Steinert, Janina Isabel and Cluver, Lucie Dale and Meinck,
               Franziska and Doubt, Jenny and Vollmer, Sebastian",
  journal   = "Journal of development economics",
  publisher = "Elsevier BV",
  volume    =  134,
  pages     = "443--466",
  abstract  = "Using data from a randomized field experiment with 552
               households, nested within 40 villages and townships in South
               Africa, we examine the impact of a brief financial literacy
               training that was integrated into a broader psychosocial
               parenting intervention. Based on self-reported measures, we
               document significant improvements in financial behaviors,
               including higher saving and lower borrowing rates. We also see
               wider implications for household economic welfare, demonstrated
               by reduced self-reported financial distress, better resilience to
               economic shocks, and a greater capacity to securing basic needs.
               We argue that program impact may run through three effect
               channels, namely improved self-efficacy, higher family and
               community social support, and greater optimism. Overall, our
               findings suggest that “hybrid” program curricula that offer
               combinations of financial and psychosocial components can add
               value to stand-alone financial literacy training.",
