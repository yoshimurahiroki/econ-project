}

@ARTICLE{Andersen2003-Modeling_And_Forecasting_Realized_Volatility-..-wq,
  title     = "Modeling and forecasting realized volatility",
  author    = "Andersen, Torben G and Bollerslev, Tim and Diebold, Francis X and
