@ARTICLE{Bachman2002-Disentangling_The_Effects_Of_Self-protective_Behaviors_On_The_Risk_Of_Injury_In_Assaults_Against_Women-..-hs,
  title     = "Disentangling the effects of self-protective behaviors on the
