  journal   = "American Economic Journal. Applied Economics",
  publisher = "American Economic Association",
  volume    =  3,
  number    =  4,
  pages     = "119--151",
  abstract  = "We construct measures of the extent to which the 4 main
               newspapers in Argentina report government corruption in their
               front page during the period 1998-2007 and correlate them with
               the extent to which each newspaper is a recipient of government
               advertising. The correlation is negative. The size is
