@ARTICLE{Kim2018-Examining_The_Relationship_Between_The_Structural_Characteristics_Of_Place_And_Crime_By_Imputing_Census_Block_Data_In_Street_Segments_Is_The_Pain_Worth_The_Gain_-..-te,
