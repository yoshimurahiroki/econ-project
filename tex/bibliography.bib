@ARTICLE{Hipp2013-Micro-_And_Macro-environment_Population_And_The_Consequences_For_Crime_Rates-..-yz,
  title     = "Micro- and macro-environment population and the consequences for
               crime rates",
  author    = "Hipp, J R and Roussell, A",
  journal   = "Social forces; a scientific medium of social study and
