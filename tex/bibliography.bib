@ARTICLE{Piza2023-Proactive_Monitoring_And_Operator_Discretion_A_Systematic_Social_Observation_Of_CCTV_Control_Room_Operations-..-ee,
  title     = "Proactive monitoring and operator discretion: A systematic social
