@ARTICLE{Ariel2017-Lowering_The_Threshold_Of_Effective_Deterrence-Testing_The_Effect_Of_Private_Security_Agents_In_Public_Spaces_On_Crime_A_Randomized_Controlled_Trial_In_A_Mass_Transit_System-..-eq,
