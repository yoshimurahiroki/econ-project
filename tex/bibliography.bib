@ARTICLE{Reyna2006-Risk_And_Rationality_In_Adolescent_Decision_Making_Implications_For_Theory_Practice_And_Public_Policy_Implications_For_Theory_Practice_And_Public_Policy-..-vh,
  title     = "Risk and rationality in adolescent decision making: Implications
