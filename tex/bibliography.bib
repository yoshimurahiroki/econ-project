  keywords  = ""
}

@ARTICLE{Kubel2023-The_Shortsighted_Victim_Short-term_Mindsets_Mediate_The_Link_Between_Victimization_And_Later_Offending-..-sr,
  title     = "The shortsighted victim: Short-term mindsets mediate the link
