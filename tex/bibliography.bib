@ARTICLE{Bottan2022-Choosing_Your_Pond_Location_Choices_And_Relative_Income-..-ak,
  title     = "Choosing your pond: Location choices and relative income",
  author    = "Bottan, Nicolas L and Perez-Truglia, Ricardo",
  journal   = "The Review of Economics and Statistics",
  publisher = "MIT Press",
  volume    =  104,
  number    =  5,
  pages     = "1010--1027",
  abstract  = "Abstract Do individuals care about their relative income? While
               this is a long-standing hypothesis, revealed-preference evidence
               remains elusive. We provide a unique test by studying residential
               choices: individuals often must choose between places with
               different income distributions, and as a result they “choose”
               their relative income. We conducted a field experiment with 1,080
               senior medical students who participated in the National Resident
               Matching Program. We estimate their preferences by combining
               choice data, survey data on perceptions, and
               information-provision experiments. The evidence suggests that
               individuals care about their relative income and that these
               preferences differ across single and nonsingle individuals.",
