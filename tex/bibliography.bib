@ARTICLE{Eitle2005-Police_Organizational_Factors_The_Racial_Composition_Of_The_Police_And_The_Probability_Of_Arrest-..-sr,
  title     = "Police organizational factors, the racial composition of the
               police, and the probability of arrest",
