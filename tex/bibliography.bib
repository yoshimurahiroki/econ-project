  year      =  2022,
  language  = "en"
}

@ARTICLE{Hipp2010-A_Dynamic_View_Of_Neighborhoods_The_Reciprocal_Relationship_Between_Crime_And_Neighborhood_Structural_Characteristics-..-bf,
