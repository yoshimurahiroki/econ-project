  year      =  2014
}

@ARTICLE{Groff2010-Is_It_Important_To_Examine_Crime_Trends_At_A_Local_micro_Level_A_Longitudinal_Analysis_Of_Street_To_Street_Variability_In_Crime_Trajectories-..-el,
  title     = "Is it important to examine crime trends at a local “micro”
