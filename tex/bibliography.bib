@ARTICLE{Jola-Sanchez2021-Inventory_In_Times_Of_War-..-qg,
  title     = "Inventory in times of war",
  author    = "Jola-Sanchez, Andres F and Serpa, Juan Camilo",
  journal   = "Management science",
  publisher = "Institute for Operations Research and the Management Sciences
               (INFORMS)",
  volume    =  67,
  number    =  10,
  pages     = "6457--6479",
  abstract  = "Using data from 38,916 businesses in war-torn Colombia and from
               5,138 attacks by the two rebel groups, FARC and ELN, we study how
               firms manage inventory during civil war. We obtain exogenous
               variation in the conflict intensity via a
               difference-in-differences model, which hinges on the peace
               process between Colombia’s government and FARC. Relying on this
               identification strategy, we hypothesize and show that war causes
               two effects on firm-level inventories. First, it leads firms to
               replace physical assets (inventory) with fungible assets (cash),
               causing them to operate with an oversecured financial buffer, but
               a fragile operational buffer. Second, this inventory reduction
               occurs mostly in unprocessed inventories (finished-goods
               inventories are insensitive to violence), meaning that, although
               war-torn businesses are equipped to fulfill planned orders, they
