@ARTICLE{Imai2025-Doubly_Robust_Uniform_Confidence_Bands_For_Group-time_Conditional_Average_Treatment_Effects_In_Difference-in-differences-..-hu,
  title         = "Doubly robust uniform confidence bands for group-time
