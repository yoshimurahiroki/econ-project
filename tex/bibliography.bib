  month     =  jan,
  year      =  2021,
  keywords  = "",
  language  = "en"
}

@ARTICLE{Copes2006-The_Key_To_Auto_Theft-..-lb,
  title     = "The key to auto theft",
  author    = "Copes, Heith and Cherbonneau, Michael",
