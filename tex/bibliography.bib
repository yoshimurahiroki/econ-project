@ARTICLE{Brilleman2014-Keep_It_Simple_Predicting_Primary_Health_Care_Costs_With_Clinical_Morbidity_Measures-..-an,
  title     = "Keep it simple? Predicting primary health care costs with
               clinical morbidity measures",
  author    = "Brilleman, Samuel L and Gravelle, Hugh and Hollinghurst, Sandra
