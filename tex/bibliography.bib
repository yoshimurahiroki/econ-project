@ARTICLE{Gilbert2023-Intimate_Partner_Violence_And_Health_Conditions_Among_U_S_Adults-National_Intimate_Partner_Violence_Survey_2010-2012-..-ga,
  title     = "Intimate partner violence and health conditions among {U}.s.
               adults-National Intimate Partner violence survey, 2010-2012",
