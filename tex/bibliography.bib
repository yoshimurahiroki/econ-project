@ARTICLE{McLay2022-When_``shelter-in-place_Isnt_Shelter_Thats_Safe_A_Rapid_Analysis_Of_Domestic_Violence_Case_Differences_During_The_COVID-19_Pandemic_And_Stay-at-home_Orders-..-ff,
