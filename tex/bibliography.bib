               compliance.",
  month     =  feb,
  year      =  2016,
  language  = "en"
}

@ARTICLE{Hanlon2009-What_Does_Tax_Aggressiveness_Signal_Evidence_From_Stock_Price_Reactions_To_News_About_Tax_Shelter_Involvement-..-nz,
