@ARTICLE{Zi2024-Examining_The_Fairness_Of_Criminal_Judicial_Procedures_In_China_A_Quantitative_Analysis_Of_The_Influential_Factors_In_The_Application_Of_Technical_Investigations_In_Drug-related_Cases-..-io,
