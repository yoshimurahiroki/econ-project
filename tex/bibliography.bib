  keywords  = "",
  language  = "en"
}

@ARTICLE{Zimmerman2014-The_Deterrence_Of_Crime_Through_Private_Security_Efforts_Theory_And_Evidence-..-th,
  title     = "The deterrence of crime through private security efforts: Theory
               and evidence",
  author    = "Zimmerman, Paul R",
  journal   = "International review of law and economics",
  publisher = "Elsevier BV",
  volume    =  37,
  pages     = "66--75",
  abstract  = "Private individuals and entities invest in a wide variety of
               market-provisioned self-protection devices or services to
               mitigate their probability of victimization to crime. However,
               evaluating the effect of such private security measures remains
               understudied in the economics of crime literature. Unlike most
