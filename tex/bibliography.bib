@ARTICLE{Roos2014-When_Kerry_Met_Sally_Politics_And_Perceptions_In_The_Demand_For_Movies-..-zx,
  title     = "When Kerry met sally: Politics and perceptions in the demand for
               movies",
  author    = "Roos, Jason M T and Shachar, Ron",
