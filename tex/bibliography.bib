@ARTICLE{Law2015-Analyzing_Hotspots_Of_Crime_Using_ABayesian_Spatiotemporal_Modeling_Approach_A_Case_Study_Of_Violent_Crime_In_TheGreaterTorontoArea_Spatiotemporal_Crime_Hotspots-..-qy,
