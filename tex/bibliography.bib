@ARTICLE{Hatten2022-When_Crime_Moves_Where_Does_It_Go_Analyzing_The_Spatial_Correlates_Of_Robbery_Incidents_Displaced_By_A_Place-based_Policing_Intervention-..-th,
  title     = "When crime moves where does it go? Analyzing the spatial
