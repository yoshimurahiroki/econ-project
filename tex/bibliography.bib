}

@ARTICLE{Bonaiuto1999-Multidimensional_Perception_Of_Residential_Environment_Quality_And_Neighbourhood_Attachment_In_The_Urban_Environment-..-af,
  title    = "Multidimensional perception of residential environment quality and
              neighbourhood attachment in the urban environment",
  author   = "Bonaiuto, M and Aiello, A and Perugini, M and Bonnes, M and
