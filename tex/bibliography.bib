@ARTICLE{Ariel2016-_Soft_Policing_At_Hot_Spots--do_Police_Community_Support_Officers_Work_A_Randomized_Controlled_Trial-..-hj,
  title     = "“Soft” policing at hot spots—do police community support officers
               work? A randomized controlled trial",
  author    = "Ariel, Barak and Weinborn, Cristobal and Sherman, Lawrence W",
