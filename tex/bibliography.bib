@ARTICLE{Tergiman2023-The_Way_People_Lie_In_Markets_Detectable_Vs_Deniable_Lies-..-hn,
  title     = "The way people lie in markets: Detectable vs. Deniable lies",
  author    = "Tergiman, Chloe and Villeval, Marie Claire",
