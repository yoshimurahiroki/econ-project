@ARTICLE{Lee2024-Analysing_Non-linearities_And_Threshold_Effects_Between_Street-level_Built_Environments_And_Local_Crime_Patterns_An_Interpretable_Machine_Learning_Approach-..-oc,
  title     = "Analysing non-linearities and threshold effects between
