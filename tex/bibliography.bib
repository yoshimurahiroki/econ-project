@ARTICLE{Stasny1991-Hierarchical_Models_For_The_Probabilities_Of_A_Survey_Classification_And_Nonresponse_An_Example_From_The_National_Crime_Survey-..-xb,
  title     = "Hierarchical models for the probabilities of a survey
               classification and nonresponse: An example from the national
               crime survey",
  author    = "Stasny, Elizabeth A",
  journal   = "Journal of the American Statistical Association",
  publisher = "Informa UK Limited",
  volume    =  86,
  number    =  414,
  pages     = "296--303",
  abstract  = "A goal in many survey sampling problems is to estimate the
               probability that elements of the population within various small
               areas or domains have some characteristic or fall in some
               particular survey classification. The estimation problem is
               typically complicated by nonrandom nonresponse in that the
               probability that a unit responds to the survey may be related to
               the characteristic of interest. This article presents a random
               parameter or hierarchical model approach to modeling the
               small-domain probabilities of the characteristic of interest and
               the probabilities of nonresponse. The general model allows
               nonresponse probabilities to depend on a unit's survey
               classification. A special case of the model treats nonresponse as
               occurring at random. Empirical Bayes methods are used to obtain
               parameter estimates under the hierarchical models. The method is
               illustrated using data from the National Crime Survey.",
  month     =  jun,
  year      =  1991
}

@ARTICLE{Truesdell1928-The_Problem_Of_Collecting_And_Standardizing_Statistics_Of_Crime_In_Forty-_Eight_Sovereign_States-..-sv,
