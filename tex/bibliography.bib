@ARTICLE{Leverentz2017-Contextualizing_Community_Crime_Control_Race_Geography_And_Configurations_Of_Control_In_Four_Communities_Contextualizing_Community_Crime_Control-..-gr,
  title     = "Contextualizing community crime control: Race, geography, and
