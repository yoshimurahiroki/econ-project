@ARTICLE{Wilkinson2007-Local_Social_Ties_And_Willingness_To_Intervene_Textured_Views_Among_Violent_Urban_Youth_Of_Neighborhood_Social_Control_Dynamics_And_Situations-..-mw,
  title     = "Local social ties and willingness to intervene: Textured views
