@ARTICLE{Abadie2008-Is_Terrorism_Eroding_Agglomeration_Economies_In_Central_Business_Districts_Lessons_From_The_Office_Real_Estate_Market_In_Downtown_Chicago-..-wg,
  title     = "Is terrorism eroding agglomeration economies in Central Business
