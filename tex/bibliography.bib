@ARTICLE{Scopelliti2015-Bias_Blind_Spot_Structure_Measurement_And_Consequences-..-io,
  title     = "Bias blind spot: Structure, measurement, and consequences",
  author    = "Scopelliti, Irene and Morewedge, Carey K and McCormick, Erin and
               Min, H Lauren and Lebrecht, Sophie and Kassam, Karim S",
  journal   = "Management science",
  publisher = "Institute for Operations Research and the Management Sciences
               (INFORMS)",
  volume    =  61,
  number    =  10,
  pages     = "2468--2486",
  abstract  = "People exhibit a bias blind spot: they are less likely to detect
               bias in themselves than in others. We report the development and
               validation of an instrument to measure individual differences in
               the propensity to exhibit the bias blind spot that is
               unidimensional, internally consistent, has high test-retest
