@ARTICLE{Tankebe2013-Viewing_Things_Differently_The_Dimensions_Of_Public_Perceptions_Of_Police_Legitimacy_Public_Perceptions_Of_Police_Legitimacy-..-is,
  title     = "Viewing things differently: The dimensions of public perceptions
               of police legitimacy: Public perceptions of police legitimacy",
