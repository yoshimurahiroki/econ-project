@ARTICLE{Karriker-Jaffe2009-Sex_Differences_In_The_Effects_Of_Neighborhood_Socioeconomic_Disadvantage_And_Social_Organization_On_Rural_Adolescents_Aggression_Trajectories-..-gx,
