@ARTICLE{Coker2025-Implementation_Evaluation_Of_Bystander_Programs_To_Reduce_Sexual_Violence_Victimization_And_Perpetration_In_College_Communities-..-et,
  title     = "Implementation evaluation of bystander programs to reduce sexual
