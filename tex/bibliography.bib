@ARTICLE{Rydberg2018-A_Quasi-experimental_Synthetic_Control_Evaluation_Of_A_Place-based_Police-directed_Patrol_Intervention_On_Violent_Crime-..-zh,
  title     = "A quasi-experimental synthetic control evaluation of a
               place-based police-directed patrol intervention on violent crime",
  author    = "Rydberg, Jason and McGarrell, Edmund F and Norris, Alexis and
