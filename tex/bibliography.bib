@ARTICLE{Zapata-Calvente2019-Gender-related_Ideological_And_Structural_Macrosocial_Factors_Associated_With_Intimate_Partner_Violence_Against_European_Women-..-xw,
  title     = "Gender-related ideological and structural macrosocial factors
