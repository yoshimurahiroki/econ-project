@ARTICLE{Rezey2020-Separated_Womens_Risk_For_Intimate_Partner_Violence_A_Multiyear_Analysis_Using_The_National_Crime_Victimization_Survey_A_Multiyear_Analysis_Using_The_National_Crime_Victimization_Survey-..-ka,
  title     = "Separated women's risk for intimate partner violence: A multiyear
               analysis using the national crime victimization survey: A
               multiyear analysis using the national crime victimization survey",
  author    = "Rezey, Maribeth L",
  journal   = "Journal of interpersonal violence",
  publisher = "SAGE Publications",
  address   = "Los Angeles, CA",
  volume    =  35,
  number    = "5-6",
  pages     = "1055--1080",
  abstract  = "The current study assesses the relative influence of various
               individual-level characteristics on the probability of intimate
               partner violence (IPV) for separated and nonseparated women.
               While previous studies have found that separated women do in fact
               have a higher risk for IPV than nonseparated women, these largely
