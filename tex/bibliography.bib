  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  13,
  number    =  4,
  pages     = "355--392",
  abstract  = "This study uses a boundary design and propensity score methods to
               study the effects of the 1930s-era Home Owners Loan Corporation
               (HOLC) “redlining” maps on the long-run trajectories of urban
               neighborhoods. The maps led to reduced home ownership rates,
