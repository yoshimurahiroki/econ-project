@ARTICLE{Bunar2007-Hate_Crimes_Against_Immigrants_In_Sweden_And_Community_Responses-..-xz,
  title     = "Hate crimes against immigrants in Sweden and community responses",
  author    = "Bunar, Nihad",
  journal   = "The American behavioral scientist",
  publisher = "SAGE Publications",
  volume    =  51,
  number    =  2,
  pages     = "166--181",
  abstract  = "The purpose of this article is to describe and analyze
               development in Sweden concerning the amount and types of reported
               hate crimes and entailed community responses. Particular
               attention is paid to offenses against immigrants. The number of
               reported xenophobic, anti-Semitic, and homophobic crimes has
               increased considerably between 1997 and 2003. The most common
               hate crimes against immigrants are threats, harassment, slander,
               ethnic agitation, and assault. The broader community (political
               state and welfare society) responded with new legislation, new
               orders to the police, a discursive offensive against racism, and
               in particular, the enactment of huge social programs in
               impoverished immigrant communities. The author analyzes some of
               the outcomes of these responses.",
  month     =  oct,
  year      =  2007,
  language  = "en"
}

@ARTICLE{Costanza_Baldry2021-The_Decision_To_Leave_The_Abusive_Partner_By_Women_Survivors_Of_Intimate_Partner_Violence_And_Risk_Of_Further_Revictimization_The_Role_Of_Gratitude_And_Risk_Perception-..-ph,
  title     = "The decision to leave the abusive partner by women survivors of
               intimate partner violence and risk of further revictimization:
