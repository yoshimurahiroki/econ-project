@ARTICLE{Su2013-Nonparametric_Dynamic_Panel_Data_Models_Kernel_Estimation_And_Specification_Testing-..-yr,
  title     = "Nonparametric dynamic panel data models: Kernel estimation and
               specification testing",
  author    = "Su, Liangjun and Lu, Xun",
  journal   = "Journal of Econometrics",
