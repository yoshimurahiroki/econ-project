@ARTICLE{Rosenfeld2014-The_Effects_Of_Directed_Patrol_And_Self-initiated_Enforcement_On_Firearm_Violence_A_Randomized_Controlled_Study_Of_Hot_Spot_Policing_The_Effects_Of_Directed_Patrol-..-ww,
  title     = "The effects of directed patrol and self‐initiated enforcement on
