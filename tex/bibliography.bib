}

@ARTICLE{Carbone-Lopez2013-Seasonal_Variation_In_Violent_Victimization_Opportunity_And_The_Annual_Rhythm_Of_The_School_Calendar-..-ge,
  title     = "Seasonal variation in violent victimization: Opportunity and the
