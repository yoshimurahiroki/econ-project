@ARTICLE{Arora2018-Latent_Fingerprint_Identification_For_Crime_Investigation_Using_Apache_Spark-..-oe,
  title     = "Latent fingerprint identification for crime investigation using
               Apache Spark",
  author    = "Arora, Shefali and Bhatia, M",
  journal   = "EngRN: Computer-Aided Engineering (Topic)",
  publisher = "papers.ssrn.com",
  abstract  = "These days, an enormous amount of heterogeneous data in various
