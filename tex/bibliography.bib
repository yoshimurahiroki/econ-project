  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  5,
  number    =  2,
  pages     = "222--250",
  abstract  = "We investigate a channel through which social capital may improve
               economic well-being and the functioning of institutions:
