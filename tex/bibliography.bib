@ARTICLE{Loh2016-Neighborhood_Disadvantage_Individual-level_Socioeconomic_Position_And_Physical_Function_A_Cross-sectional_Multilevel_Analysis-..-oh,
  title     = "Neighborhood disadvantage, individual-level socioeconomic
