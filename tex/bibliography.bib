@ARTICLE{Rodriguez2021-The_Perfect_Storm_Hidden_Risk_Of_Child_Maltreatment_During_The_Covid-19_Pandemic-..-ip,
  title     = "The perfect storm: Hidden risk of child maltreatment during the
               Covid-19 pandemic",
  author    = "Rodriguez, Christina M and Lee, Shawna J and Ward, Kaitlin P and
