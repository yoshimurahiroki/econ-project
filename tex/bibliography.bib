  language  = "en"
}

@ARTICLE{Telep2014-How_Much_Time_Should_The_Police_Spend_At_Crime_Hot_Spots_Answers_From_A_Police_Agency_Directed_Randomized_Field_Trial_In_Sacramento_California-..-zr,
