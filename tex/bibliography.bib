@ARTICLE{Stephens-Davidowitz2014-The_Cost_Of_Racial_Animus_On_A_Black_Candidate_Evidence_Using_Google_Search_Data-..-ua,
  title     = "The cost of racial animus on a black candidate: Evidence using
               Google search data",
  author    = "Stephens-Davidowitz, Seth",
