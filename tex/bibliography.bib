}

@ARTICLE{Hoeboer2023-The_Impact_Of_COVID-19_On_Crime_A_Systematic_Review-..-yk,
  title     = "The impact of {COVID}-19 on crime: A systematic review",
  author    = "Hoeboer, C M and Kitselaar, W M and Henrich, J F and
