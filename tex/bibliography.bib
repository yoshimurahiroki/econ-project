  year      =  2007,
  keywords  = "",
  language  = "en"
}

@ARTICLE{Quick2018-Crime-general_And_Crime-specific_Spatial_Patterns_A_Multivariate_Spatial_Analysis_Of_Four_Crime_Types_At_The_Small-area_Scale-..-or,
