  author    = "Carneiro, Pedro and Ginja, Rita",
  journal   = "American Economic Journal. Economic Policy",
  publisher = "American Economic Association",
  volume    =  6,
  number    =  4,
  pages     = "135--173",
  abstract  = "This paper provides new estimates of the medium- and long-term
