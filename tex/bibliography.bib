@ARTICLE{Meng2014-Estimation_Of_Own_And_Cross_Price_Elasticities_Of_Alcohol_Demand_In_The_UK-A_Pseudo-panel_Approach_Using_The_Living_Costs_And_Food_Survey_2001-2009-..-og,
