@ARTICLE{Pain2006-_when_Where_If_And_But_Qualifying_GIS_And_The_Effect_Of_Streetlighting_On_Crime_And_Fear-..-ih,
  title     = "‘when, where, if, and but’: Qualifying {GIS} and the effect of
