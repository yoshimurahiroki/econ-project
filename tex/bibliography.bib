@ARTICLE{O_Malley2006-Reinventing_Prevention_Why_Did_Crime_Prevention_Develop_So_Late_-..-ki,
  title     = "Reinventing prevention: Why did 'crime prevention' develop so
               late?",
  author    = "O'Malley, P and Hutchinson, S",
  journal   = "The British journal of criminology",
