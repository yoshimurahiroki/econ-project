@ARTICLE{van_Sleeuwen2018-A_Time_For_A_Crime_Temporal_Aspects_Of_Repeat_Offenders_Crime_Location_Choices-..-tn,
  title     = "A time for a crime: Temporal aspects of repeat offenders’ crime
