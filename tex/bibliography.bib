@ARTICLE{Naghizadeh2021-Domestic_Violence_And_Its_Relationship_With_Quality_Of_Life_In_Pregnant_Women_During_The_Outbreak_Of_COVID-19_Disease-..-tw,
  title     = "Domestic violence and its relationship with quality of life in
