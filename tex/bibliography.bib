@ARTICLE{Mahfoud2021-Forecasting_Spatio-temporal_Variation_In_Residential_Burglary_With_The_Integrated_Laplace_Approximation_Framework_Effects_Of_Crime_Generators_Street_Networks_And_Prior_Crimes-..-ej,
