{
  "name": "econ-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/econ-project",
  "updateRemoteUserUID": true,
  "mounts": [
    "type=volume,source=econ_data,target=/workspaces/econ-project/data",
    "type=volume,source=econ_pixi_cache,target=/home/vscode/.cache/rattler",
    "type=volume,source=econ_pixi_env,target=/workspaces/econ-project/.pixi"
  ],
  "runArgs": [
    "--init",
    "--hostname=econ-dev"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "hostRequirements": {
    "gpu": "optional"
  },
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {},
  "remoteEnv": {
    "ECC_UPDATE_SKILLS": "0",
    "ECC_FETCH_AI_REFERENCES": "0",
    "ENABLE_CONTEXT_MCP": "0",
    "PATH": "/usr/local/bin:/workspaces/econ-project/.pixi/envs/default/bin:${containerEnv:PATH}",
    "QUARTO_PYTHON": "/workspaces/econ-project/.pixi/envs/default/bin/python",
    "QUARTO_SHARE_PATH": "/workspaces/econ-project/.pixi/envs/default/share/quarto",
    "QUARTO_DENO": "/workspaces/econ-project/.pixi/envs/default/bin/deno",
    "QUARTO_DENO_DOM": "/workspaces/econ-project/.pixi/envs/default/lib/deno_dom.so",
    "QUARTO_PANDOC": "/workspaces/econ-project/.pixi/envs/default/bin/pandoc",
    "QUARTO_ESBUILD": "/workspaces/econ-project/.pixi/envs/default/bin/esbuild",
    "QUARTO_TYPST": "/workspaces/econ-project/.pixi/envs/default/bin/typst",
    "QUARTO_DART_SASS": "/workspaces/econ-project/.pixi/envs/default/bin/sass",
    "QUARTO_CONDA_PREFIX": "/workspaces/econ-project/.pixi/envs/default"
  },
  "postCreateCommand": "bash .devcontainer/setup-environment.sh",
  "updateContentCommand": "bash .devcontainer/setup-environment.sh",
  "customizations": {
    "antigravity": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "ms-python.black-formatter",
        "ms-python.isort",
        "pytest-dev.pytest-vscode",
        "James-Yu.latex-workshop",
        "tecosaur.latex-utilities",
        "quarto.quarto",
        "REditorSupport.r",
        "RDebugger.r-debugger",
        "ikuyadeu.r-lsp",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "DavidAnson.vscode-markdownlint",
        "ms-vscode.makefile-tools",
        "EditorConfig.EditorConfig",
        "ms-python.vscode-python-envs",
        "ms-python.debugpy",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-toolsai.datawrangler",
        "ms-toolsai.tensorboard",
        "njpwerner.autodocstring",
        "usernamehw.errorlens",
        "Gruntfuggly.todo-tree",
        "oderwat.indent-rainbow",
        "mechatroner.rainbow-csv",
        "janisdd.vscode-edit-csv",
        "GrapeCity.gc-excelviewer",
        "RandomFractalsInc.vscode-data-preview",
        "RandomFractalsInc.tabular-data-viewer",
        "qwtel.sqlite-viewer",
        "msrvida.vscode-sanddance",
        "RandomFractalsInc.geo-data-viewer",
        "RandomFractalsInc.vscode-vega-viewer",
        "RandomFractalsInc.vscode-data-table",
        "ms-vscode.hexeditor",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-sqlite",
        "mtxr.sqltools-driver-pg",
        "mtxr.sqltools-driver-mysql",
        "mtxr.sqltools-driver-mssql",
        "Evidence.sqltools-duckdb-driver",
        "ms-mssql.mssql",
        "julialang.language-julia",
        "kylebarron.stata-enhanced",
        "lakeFS.lakefs-dvc",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "valentjn.vscode-ltex",
        "streetsidesoftware.code-spell-checker",
        "marp-team.marp-vscode",
        "hediet.vscode-drawio",
        "redhat.vscode-xml",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "mhutchie.git-graph",
        "GitHub.vscode-pull-request-github",
        "github.vscode-github-actions",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "humao.rest-client",
        "dotenv.dotenv-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "remote.extensionKind": {
          "openai.chatgpt": [
            "ui"
          ]
        },
        "git.untrackedChanges": "hidden",
        "python.formatting.provider": "none",
        "python.analysis.typeCheckingMode": "strict",
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
        "python-envs.workspaceSearchPaths": [],
        "python.terminal.activateEnvironment": false,
        "python.terminal.activateEnvInCurrentTerminal": false,
        "quarto.path": "/usr/local/bin/quarto",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "latex-workshop.latex.recipe.default": "lualatex (with build dir)",
        "latex-workshop.latex.recipes": [
          {
            "name": "lualatex (with build dir)",
            "tools": [
              "lualatex-with-build-dir"
            ]
          }
        ],
        "latex-workshop.latex.tools": [
          {
            "name": "lualatex-with-build-dir",
            "command": "bash",
            "args": [
              "-lc",
              "cd %DIR% && mkdir -p .latex-build && lualatex -shell-escape -interaction=nonstopmode -file-line-error -output-directory=.latex-build %DOCFILE%.tex && cp .latex-build/%DOCFILE%.pdf %DOCFILE%.pdf && rm -f %DOCFILE%.aux %DOCFILE%.log %DOCFILE%.nav %DOCFILE%.out %DOCFILE%.snm %DOCFILE%.toc %DOCFILE%.bbl %DOCFILE%.blg %DOCFILE%.synctex.gz %DOCFILE%.fls %DOCFILE%.fdb_latexmk %DOCFILE%.bcf %DOCFILE%.run.xml || true"
            ]
          }
        ],
        "files.exclude": {
          "**/env": true,
          "**/.venv": true,
          "**/__pycache__": true,
          "**/*.pyc": true,
          "**/.resources": true,
          "**/.agent_state": true
        },
        "search.exclude": {
          "**/.pixi": true,
          "**/node_modules": true,
          "**/.resources": true,
          "**/.agent_state": true
        },
        "files.watcherExclude": {
          "**/.pixi/**": true,
          "**/node_modules/**": true,
          "**/.resources/**": true,
          "**/.agent_state/**": true
        },
        "ruff.lint.args": [
          "--config=pyproject.toml"
        ],
        "ruff.format.args": [
          "--config=pyproject.toml"
        ],
        "r.rterm.linux": "/workspaces/econ-project/.pixi/envs/default/bin/R",
        "r.rpath.linux": "/workspaces/econ-project/.pixi/envs/default/bin/R",
        "code-runner.executorMap": {
          "python": "/workspaces/econ-project/.pixi/envs/default/bin/python -u",
          "r": "/workspaces/econ-project/.pixi/envs/default/bin/Rscript"
        },
        "notebook.formatOnSave.enabled": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.cwd": "${workspaceFolder}",
        "python.analysis.diagnosticMode": "workspace",
        "sqltools.useNodeRuntime": true,
        "sqltools.disableNodeDetectNotifications": true,
        "markdown.extension.toc.updateOnSave": false,
        "ltex.language": "en-US",
        "files.associations": {
          "*.qmd": "quarto",
          "*.do": "stata",
          "*.ado": "stata",
          "*.Rmd": "rmd",
          "*.R": "r",
          "*.ipynb": "jupyter-notebook",
          "*.parquet": "parquet",
          "*.duckdb": "duckdb",
          "*.db": "sqlite",
          "*.sqlite": "sqlite"
        }
      }
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "ms-python.black-formatter",
        "ms-python.isort",
        "pytest-dev.pytest-vscode",
        "James-Yu.latex-workshop",
        "tecosaur.latex-utilities",
        "quarto.quarto",
        "REditorSupport.r",
        "RDebugger.r-debugger",
        "ikuyadeu.r-lsp",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "DavidAnson.vscode-markdownlint",
        "ms-vscode.makefile-tools",
        "EditorConfig.EditorConfig",
        "ms-python.vscode-python-envs",
        "ms-python.debugpy",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-toolsai.datawrangler",
        "ms-toolsai.tensorboard",
        "njpwerner.autodocstring",
        "usernamehw.errorlens",
        "Gruntfuggly.todo-tree",
        "oderwat.indent-rainbow",
        "mechatroner.rainbow-csv",
        "janisdd.vscode-edit-csv",
        "GrapeCity.gc-excelviewer",
        "RandomFractalsInc.vscode-data-preview",
        "RandomFractalsInc.tabular-data-viewer",
        "qwtel.sqlite-viewer",
        "msrvida.vscode-sanddance",
        "RandomFractalsInc.geo-data-viewer",
        "RandomFractalsInc.vscode-vega-viewer",
        "RandomFractalsInc.vscode-data-table",
        "ms-vscode.hexeditor",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-sqlite",
        "mtxr.sqltools-driver-pg",
        "mtxr.sqltools-driver-mysql",
        "mtxr.sqltools-driver-mssql",
        "Evidence.sqltools-duckdb-driver",
        "ms-mssql.mssql",
        "julialang.language-julia",
        "kylebarron.stata-enhanced",
        "lakeFS.lakefs-dvc",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "valentjn.vscode-ltex",
        "streetsidesoftware.code-spell-checker",
        "marp-team.marp-vscode",
        "hediet.vscode-drawio",
        "redhat.vscode-xml",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers",
        "mhutchie.git-graph",
        "GitHub.vscode-pull-request-github",
        "github.vscode-github-actions",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "humao.rest-client",
        "dotenv.dotenv-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "remote.extensionKind": {
          "openai.chatgpt": [
            "ui"
          ]
        },
        "git.untrackedChanges": "hidden",
        "python.formatting.provider": "none",
        "python.analysis.typeCheckingMode": "strict",
        "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/default/bin/python",
        "python-envs.workspaceSearchPaths": [],
        "python.terminal.activateEnvironment": false,
        "python.terminal.activateEnvInCurrentTerminal": false,
        "quarto.path": "/usr/local/bin/quarto",
        "jupyter.notebookFileRoot": "${workspaceFolder}",
        "latex-workshop.latex.recipe.default": "lualatex (with build dir)",
        "latex-workshop.latex.recipes": [
          {
            "name": "lualatex (with build dir)",
            "tools": [
              "lualatex-with-build-dir"
            ]
          }
        ],
        "latex-workshop.latex.tools": [
          {
            "name": "lualatex-with-build-dir",
            "command": "bash",
            "args": [
              "-lc",
              "cd %DIR% && mkdir -p .latex-build && lualatex -shell-escape -interaction=nonstopmode -file-line-error -output-directory=.latex-build %DOCFILE%.tex && cp .latex-build/%DOCFILE%.pdf %DOCFILE%.pdf && rm -f %DOCFILE%.aux %DOCFILE%.log %DOCFILE%.nav %DOCFILE%.out %DOCFILE%.snm %DOCFILE%.toc %DOCFILE%.bbl %DOCFILE%.blg %DOCFILE%.synctex.gz %DOCFILE%.fls %DOCFILE%.fdb_latexmk %DOCFILE%.bcf %DOCFILE%.run.xml || true"
            ]
          }
        ],
        "files.exclude": {
          "**/env": true,
          "**/.venv": true,
          "**/__pycache__": true,
          "**/*.pyc": true,
          "**/.resources": true,
          "**/.agent_state": true
        },
        "search.exclude": {
          "**/.pixi": true,
          "**/node_modules": true,
          "**/.resources": true,
          "**/.agent_state": true
        },
        "files.watcherExclude": {
          "**/.pixi/**": true,
          "**/node_modules/**": true,
          "**/.resources/**": true,
          "**/.agent_state/**": true
        },
        "ruff.lint.args": [
          "--config=pyproject.toml"
        ],
        "ruff.format.args": [
          "--config=pyproject.toml"
        ],
        "r.rterm.linux": "${workspaceFolder}/.pixi/envs/default/bin/R",
        "code-runner.executorMap": {
          "python": "${workspaceFolder}/.pixi/envs/default/bin/python -u",
          "r": "${workspaceFolder}/.pixi/envs/default/bin/Rscript"
        },
        "notebook.formatOnSave.enabled": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.cwd": "${workspaceFolder}",
        "python.analysis.diagnosticMode": "workspace",
        "sqltools.useNodeRuntime": true,
        "sqltools.disableNodeDetectNotifications": true,
        "markdown.extension.toc.updateOnSave": false,
        "ltex.language": "en-US",
        "files.associations": {
          "*.qmd": "quarto",
          "*.do": "stata",
          "*.ado": "stata",
          "*.Rmd": "rmd",
          "*.R": "r",
          "*.ipynb": "jupyter-notebook",
          "*.parquet": "parquet",
          "*.duckdb": "duckdb",
          "*.db": "sqlite",
          "*.sqlite": "sqlite"
        }
      }
    }
  }
}
