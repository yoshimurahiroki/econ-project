{
  "name": "econ-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "updateRemoteUserUID": true,
  "mounts": [
    "type=volume,source=econ_data_${devcontainerId},target=/workspaces/${localWorkspaceFolderBasename}/data",
    "type=volume,source=econ_pixi_cache,target=/home/vscode/.cache/rattler",
    "type=volume,source=econ_pixi_env_${devcontainerId},target=/workspaces/${localWorkspaceFolderBasename}/.pixi"
  ],
  "runArgs": [
    "--init",
    "--hostname=econ-dev"
  ],
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "enableNonRootDocker": "true",
      "moby": "true"
    }
  },
  "hostRequirements": {
    "gpu": "optional"
  },
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {},
  "remoteEnv": {
    "ENABLE_CONTEXT_MCP": "0",
    "PATH": "${containerWorkspaceFolder}/.pixi/envs/default/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/setup-environment.sh",
  "customizations": {
    "antigravity": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "REditorSupport.r",
        "quarto.quarto",
        "James-Yu.latex-workshop",
        "charliermarsh.ruff"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "REditorSupport.r",
        "quarto.quarto",
        "James-Yu.latex-workshop",
        "charliermarsh.ruff"
      ]
    }
  }
}
